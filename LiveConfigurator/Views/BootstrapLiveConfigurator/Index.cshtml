            "#dmbPreviewScope .btn-primary:disabled, #previewColors .btn-primary:disabled{background-color:" + primaryDisabled + " !important;border-color:" + primaryDisabled + " !important;color:#fff !important;opacity:1 !important;}",
            "#saveAsProfile:active{background-color:" + primaryActive + " !important;border-color:" + primaryActive + " !important;}",
            "#dmbPreviewScope .btn-secondary, #previewColors .btn-secondary{background-color:" + config.secondaryColor + " !important;border-color:" + config.secondaryColor + " !important;color:#fff !important;}",
            "#dmbPreviewScope .btn-secondary:hover, #previewColors .btn-secondary:hover{background-color:" + secondaryHover + " !important;border-color:" + secondaryHover + " !important;}",
            "#dmbPreviewScope .btn-secondary:disabled, #previewColors .btn-secondary:disabled{background-color:" + secondaryDisabled + " !important;border-color:" + secondaryDisabled + " !important;color:#fff !important;opacity:1 !important;}",
            "#saveCurrentProfile{color:" + config.secondaryColor + " !important;border-color:" + config.secondaryColor + " !important;}",
            "#saveCurrentProfile:hover{background-color:" + config.secondaryColor + " !important;border-color:" + config.secondaryColor + " !important;color:#fff !important;}",
            "#restoreProfile{color:" + config.secondaryColor + " !important;border-color:" + config.secondaryColor + " !important;}",
            "#restoreProfile:hover{background-color:" + config.secondaryColor + " !important;border-color:" + config.secondaryColor + " !important;color:#fff !important;}",
            "#dmbPreviewScope .btn-success, #previewColors .btn-success{background-color:" + config.successColor + " !important;border-color:" + config.successColor + " !important;color:#fff !important;}",
            "#dmbPreviewScope .btn-success:hover, #previewColors .btn-success:hover{background-color:" + successHover + " !important;border-color:" + successHover + " !important;}",
            "#dmbPreviewScope .btn-success:disabled, #previewColors .btn-success:disabled{background-color:" + successDisabled + " !important;border-color:" + successDisabled + " !important;color:#fff !important;opacity:1 !important;}",
