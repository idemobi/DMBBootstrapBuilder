    function toRgbString(hexColor) {
        const value = (hexColor || "").replace("#", "").trim();
        if (value.length !== 6) return null;
        const r = Number.parseInt(value.substring(0, 2), 16);
        const g = Number.parseInt(value.substring(2, 4), 16);
        const b = Number.parseInt(value.substring(4, 6), 16);
        if (Number.isNaN(r) || Number.isNaN(g) || Number.isNaN(b)) return null;
        return r + ", " + g + ", " + b;
    }

    function shadeColor(hexColor, factor) {
        const value = (hexColor || "").replace("#", "").trim();
        if (value.length !== 6) return hexColor;
        const r = Number.parseInt(value.substring(0, 2), 16);
        const g = Number.parseInt(value.substring(2, 4), 16);
        const b = Number.parseInt(value.substring(4, 6), 16);
        if (Number.isNaN(r) || Number.isNaN(g) || Number.isNaN(b)) return hexColor;
        const clamp = n => Math.max(0, Math.min(255, Math.round(n)));
        const toHex = n => clamp(n).toString(16).padStart(2, "0");
        return "#" + toHex(r * factor) + toHex(g * factor) + toHex(b * factor);
    }
    function hexToRgba(hexColor, alpha) {
        const value = (hexColor || "").replace("#", "").trim();
        if (value.length !== 6) return hexColor;
        const r = Number.parseInt(value.substring(0, 2), 16);
        const g = Number.parseInt(value.substring(2, 4), 16);
        const b = Number.parseInt(value.substring(4, 6), 16);
        if (Number.isNaN(r) || Number.isNaN(g) || Number.isNaN(b)) return hexColor;
        return "rgba(" + r + ", " + g + ", " + b + ", " + alpha + ")";
    }

    function applyCssVars(config) {
        const root = document.documentElement;
        const previewFallbackTag = document.getElementById("dmb-live-configurator-preview-fallback");
        if (previewFallbackTag) previewFallbackTag.remove();
        const typographyFallbackTag = document.getElementById("dmb-live-configurator-preview-typography-fallback");
        if (typographyFallbackTag) typographyFallbackTag.remove();

        const bodyFontFamilyResolved = resolveBodyFontFamily(config);
        const headingFontFamilyResolved = resolveHeadingFontFamily(config);

        root.style.setProperty("--bs-primary", config.primaryColor);
        root.style.setProperty("--bs-secondary", config.secondaryColor);
        root.style.setProperty("--bs-success", config.successColor);
        root.style.setProperty("--bs-danger", config.dangerColor);
        root.style.setProperty("--bs-warning", config.warningColor);
        root.style.setProperty("--bs-info", config.infoColor);
        root.style.setProperty("--bs-link-color", config.linkColor);
        root.style.setProperty("--bs-border-color", config.borderColor);
        root.style.setProperty("--bs-border-color-translucent", "rgba(0, 0, 0, " + config.borderColorTranslucent + ")");
        root.style.setProperty("--bs-border-radius", pxToRem(config.borderRadiusPx));
        root.style.setProperty("--bs-border-width", config.borderWidthPx + "px");
        root.style.setProperty("--bs-card-border-color", config.borderColor);
        root.style.setProperty("--bs-card-border-width", config.borderWidthPx + "px");
        root.style.setProperty("--bs-card-border-radius", pxToRem(config.borderRadiusPx));

        const primaryRgb = toRgbString(config.primaryColor);
        const secondaryRgb = toRgbString(config.secondaryColor);
        const successRgb = toRgbString(config.successColor);
        const dangerRgb = toRgbString(config.dangerColor);
        const warningRgb = toRgbString(config.warningColor);
        const infoRgb = toRgbString(config.infoColor);

        if (primaryRgb) root.style.setProperty("--bs-primary-rgb", primaryRgb);
        if (secondaryRgb) root.style.setProperty("--bs-secondary-rgb", secondaryRgb);
        if (successRgb) root.style.setProperty("--bs-success-rgb", successRgb);
        if (dangerRgb) root.style.setProperty("--bs-danger-rgb", dangerRgb);
        if (warningRgb) root.style.setProperty("--bs-warning-rgb", warningRgb);
        if (infoRgb) root.style.setProperty("--bs-info-rgb", infoRgb);

        root.style.fontSize = (config.fontScalePercent / 100).toFixed(3) + "rem";
        root.style.lineHeight = (config.lineHeight / 100).toFixed(2);
        root.style.setProperty("--bs-body-font-family", bodyFontFamilyResolved);

        const spacingGridRow = document.getElementById("spacingGridRow");
        if (spacingGridRow) {
            spacingGridRow.style.setProperty("--bs-gutter-x", config.gridGutterRem + "rem");
        }

        ensureGoogleFontLoaded(config.googleBodyFont);
        ensureGoogleFontLoaded(config.googleHeadingFont);
        applyComponentOverrides(config);
    }

