@functions {
    private IHtmlContent RenderSettingRow(string label, string id, string inputType, string value, string info, string? min = null, string? max = null, string? step = null)
    {
        var isCardParam = id.StartsWith("card", StringComparison.Ordinal);
        var minAttr = string.IsNullOrWhiteSpace(min) ? string.Empty : $" min=\"{min}\"";
        var maxAttr = string.IsNullOrWhiteSpace(max) ? string.Empty : $" max=\"{max}\"";
        var stepAttr = string.IsNullOrWhiteSpace(step) ? string.Empty : $" step=\"{step}\"";
        var docEntry = GetBootstrapDocInfo(id);
        var enrichedInfo = info;
        if (!string.IsNullOrWhiteSpace(docEntry.Variable))
        {
            enrichedInfo += $" | Bootstrap variable: {docEntry.Variable}";
        }
        if (!string.IsNullOrWhiteSpace(docEntry.Url))
        {
            enrichedInfo += $" | Docs: {docEntry.Url}";
        }
        var escapedInfo = System.Net.WebUtility.HtmlEncode(enrichedInfo);
        var controlClass = inputType == "color"
            ? "form-control form-control-color"
            : inputType == "range"
                ? "form-range"
                : "form-control form-control-sm";
        string controlMarkup;
        if (id == "fontFamilySansSerif")
        {
            controlMarkup = $"""
            <select id="{id}" class="form-select form-select-sm">
                <option value="system-ui, -apple-system, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif"{(value == "system-ui, -apple-system, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif" ? " selected" : "")}>System UI</option>
                <option value="Arial, Helvetica, sans-serif"{(value == "Arial, Helvetica, sans-serif" ? " selected" : "")}>Arial</option>
                <option value="Verdana, Geneva, sans-serif"{(value == "Verdana, Geneva, sans-serif" ? " selected" : "")}>Verdana</option>
                <option value="Tahoma, Geneva, sans-serif"{(value == "Tahoma, Geneva, sans-serif" ? " selected" : "")}>Tahoma</option>
                <option value="Trebuchet MS, Arial, sans-serif"{(value == "Trebuchet MS, Arial, sans-serif" ? " selected" : "")}>Trebuchet MS</option>
                <option value="Gill Sans, Gill Sans MT, Calibri, sans-serif"{(value == "Gill Sans, Gill Sans MT, Calibri, sans-serif" ? " selected" : "")}>Gill Sans</option>
                <option value="Segoe UI, Tahoma, Geneva, Verdana, sans-serif"{(value == "Segoe UI, Tahoma, Geneva, Verdana, sans-serif" ? " selected" : "")}>Segoe UI</option>
            </select>
            """;
        }
        else if (id == "headingsFontFamily")
        {
            controlMarkup = $"""
            <select id="{id}" class="form-select form-select-sm">
                <option value="inherit"{(value == "inherit" ? " selected" : "")}>Inherit (body)</option>
                <option value="system-ui, -apple-system, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif"{(value == "system-ui, -apple-system, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif" ? " selected" : "")}>System UI</option>
                <option value="Georgia, Times New Roman, serif"{(value == "Georgia, Times New Roman, serif" ? " selected" : "")}>Georgia</option>
                <option value="Times New Roman, Times, serif"{(value == "Times New Roman, Times, serif" ? " selected" : "")}>Times New Roman</option>
                <option value="Palatino Linotype, Book Antiqua, Palatino, serif"{(value == "Palatino Linotype, Book Antiqua, Palatino, serif" ? " selected" : "")}>Palatino</option>
                <option value="Garamond, serif"{(value == "Garamond, serif" ? " selected" : "")}>Garamond</option>
                <option value="Arial, Helvetica, sans-serif"{(value == "Arial, Helvetica, sans-serif" ? " selected" : "")}>Arial</option>
            </select>
            """;
        }
        else if (id == "googleBodyFont")
        {
            controlMarkup = $"""
            <select id="{id}" class="form-select form-select-sm">
                <option value=""{(string.IsNullOrWhiteSpace(value) ? " selected" : "")}>None</option>
                <option value="Inter"{(value == "Inter" ? " selected" : "")}>Inter</option>
                <option value="Roboto"{(value == "Roboto" ? " selected" : "")}>Roboto</option>
                <option value="Open Sans"{(value == "Open Sans" ? " selected" : "")}>Open Sans</option>
                <option value="Lato"{(value == "Lato" ? " selected" : "")}>Lato</option>
                <option value="Montserrat"{(value == "Montserrat" ? " selected" : "")}>Montserrat</option>
            </select>
            """;
        }
        else if (id == "googleHeadingFont")
        {
            controlMarkup = $"""
            <select id="{id}" class="form-select form-select-sm">
                <option value=""{(string.IsNullOrWhiteSpace(value) ? " selected" : "")}>None</option>
                <option value="Playfair Display"{(value == "Playfair Display" ? " selected" : "")}>Playfair Display</option>
                <option value="Merriweather"{(value == "Merriweather" ? " selected" : "")}>Merriweather</option>
                <option value="Oswald"{(value == "Oswald" ? " selected" : "")}>Oswald</option>
                <option value="Nunito Sans"{(value == "Nunito Sans" ? " selected" : "")}>Nunito Sans</option>
                <option value="Poppins"{(value == "Poppins" ? " selected" : "")}>Poppins</option>
            </select>
            """;
        }
        else
        {
            controlMarkup = $"<input id=\"{id}\" class=\"{controlClass}\" type=\"{inputType}\" value=\"{value}\"{minAttr}{maxAttr}{stepAttr} />";
        }

        var modeCellMarkup = "<span class=\"text-muted\">-</span>";
        if (isCardParam)
        {
            var modeId = id + "Mode";
            var formulaOption = id == "cardBorderRadiusPx"
                ? "<option value=\"formula\">formula</option>"
                : string.Empty;
            modeCellMarkup = $"<select id=\"{modeId}\" class=\"form-select form-select-sm dmb-mode-select\" data-mode-target=\"{id}\"><option value=\"inherit\" selected>inherit</option><option value=\"custom\">custom</option>{formulaOption}</select>";
        }

        return new HtmlString($"""
        <tr>
            <td class="text-nowrap">{label}</td>
            <td>
                {modeCellMarkup}
            </td>
            <td>
                {controlMarkup}
            </td>
            <td class="dmb-value-cell"><span id="{id}ValueLabel" data-value-for="{id}">{value}</span></td>
            <td class="dmb-action-cell" style="width:1%">
                <button type="button" class="btn btn-sm btn-outline-secondary dmb-action-btn" data-reset-target="{id}">Reset</button>
            </td>
            <td class="dmb-action-cell" style="width:1%">
                <button type="button" class="btn btn-sm btn-outline-info dmb-action-btn"
                        data-bs-toggle="popover"
                        data-bs-trigger="hover focus"
                        data-bs-placement="top"
                        data-bs-content="{escapedInfo}">
                    <span class="bi bi-info-circle"></span>
                </button>
            </td>
        </tr>
        """);
    }

    private (string Variable, string Url) GetBootstrapDocInfo(string id)
    {
        const string customizeUrl = "https://getbootstrap.com/docs/5.3/customize/sass/";
        const string formsUrl = "https://getbootstrap.com/docs/5.3/forms/overview/";
        const string buttonsUrl = "https://getbootstrap.com/docs/5.3/components/buttons/";
        const string cardsUrl = "https://getbootstrap.com/docs/5.3/components/card/";
        const string navsUrl = "https://getbootstrap.com/docs/5.3/components/navs-tabs/";
        const string dropdownUrl = "https://getbootstrap.com/docs/5.3/components/dropdowns/";
        const string modalUrl = "https://getbootstrap.com/docs/5.3/components/modal/";
        const string tablesUrl = "https://getbootstrap.com/docs/5.3/content/tables/";
        const string utilitiesUrl = "https://getbootstrap.com/docs/5.3/utilities/api/";

        return id switch
        {
            "primaryColor" => ("$primary", customizeUrl),
            "secondaryColor" => ("$secondary", customizeUrl),
            "successColor" => ("$success", customizeUrl),
            "dangerColor" => ("$danger", customizeUrl),
            "warningColor" => ("$warning", customizeUrl),
            "infoColor" => ("$info", customizeUrl),
            "fontScalePercent" => ("$font-size-base", customizeUrl),
            "lineHeight" => ("$line-height-base", customizeUrl),
            "fontFamilySansSerif" => ("$font-family-sans-serif", customizeUrl),
            "headingsFontFamily" => ("$headings-font-family", customizeUrl),
            "headingsFontWeight" => ("$headings-font-weight", customizeUrl),
            "headingsLineHeight" => ("$headings-line-height", customizeUrl),
            "leadFontSize" => ("$lead-font-size", customizeUrl),
            "smallFontSize" => ("$small-font-size", customizeUrl),
            "borderRadiusPx" => ("$border-radius", customizeUrl),
            "borderWidthPx" => ("$border-width", customizeUrl),
            "borderColor" => ("$border-color", customizeUrl),
            "borderColorTranslucent" => ("$border-color-translucent", customizeUrl),
            "borderRadiusSmPx" => ("$border-radius-sm", customizeUrl),
            "borderRadiusLgPx" => ("$border-radius-lg", customizeUrl),
            "borderRadiusXlPx" => ("$border-radius-xl", customizeUrl),
            "borderRadiusPillPx" => ("$border-radius-pill", customizeUrl),
            "spacerRem" => ("$spacer", customizeUrl),
            "gridGutterRem" => ("$grid-gutter-width", customizeUrl),
            "spacer0" => ("$spacers", customizeUrl),
            "spacer1" => ("$spacers", customizeUrl),
            "spacer2" => ("$spacers", customizeUrl),
            "spacer3" => ("$spacers", customizeUrl),
            "spacer4" => ("$spacers", customizeUrl),
            "spacer5" => ("$spacers", customizeUrl),
            "bpXs" => ("$grid-breakpoints", customizeUrl),
            "bpSm" => ("$grid-breakpoints", customizeUrl),
            "bpMd" => ("$grid-breakpoints", customizeUrl),
            "bpLg" => ("$grid-breakpoints", customizeUrl),
            "bpXl" => ("$grid-breakpoints", customizeUrl),
            "bpXxl" => ("$grid-breakpoints", customizeUrl),
            "cwSm" => ("$container-max-widths", customizeUrl),
            "cwMd" => ("$container-max-widths", customizeUrl),
            "cwLg" => ("$container-max-widths", customizeUrl),
            "cwXl" => ("$container-max-widths", customizeUrl),
            "cwXxl" => ("$container-max-widths", customizeUrl),
            "linkColor" => ("$link-color", customizeUrl),
            "linkHoverColor" => ("$link-hover-color", customizeUrl),
            "linkDecoration" => ("$link-decoration", customizeUrl),
            "focusRingColor" => ("$focus-ring-color", customizeUrl),
            "focusRingWidthPx" => ("$focus-ring-width", customizeUrl),
            "inputBg" => ("$input-bg", formsUrl),
            "inputColor" => ("$input-color", formsUrl),
            "inputBorderColor" => ("$input-border-color", formsUrl),
            "inputFocusBorderColor" => ("$input-focus-border-color", formsUrl),
            "inputBtnPaddingYRem" => ("$input-btn-padding-y", formsUrl),
            "inputBtnPaddingXRem" => ("$input-btn-padding-x", formsUrl),
            "btnPaddingYRem" => ("$btn-padding-y", buttonsUrl),
            "btnPaddingXRem" => ("$btn-padding-x", buttonsUrl),
            "btnBorderRadiusPx" => ("$btn-border-radius", buttonsUrl),
            "formSelectIndicatorColor" => ("$form-select-indicator-color", formsUrl),
            "cardBg" => ("$card-bg", cardsUrl),
            "cardBorderColor" => ("$card-border-color", cardsUrl),
            "cardBorderWidthPx" => ("$card-border-width", cardsUrl),
            "cardBorderRadiusPx" => ("$card-border-radius", cardsUrl),
            "modalContentBg" => ("$modal-content-bg", modalUrl),
            "modalBackdropOpacity" => ("$modal-backdrop-opacity", modalUrl),
            "dropdownBg" => ("$dropdown-bg", dropdownUrl),
            "dropdownLinkHoverBg" => ("$dropdown-link-hover-bg", dropdownUrl),
            "navLinkColor" => ("$nav-link-color", navsUrl),
            "navLinkHoverColor" => ("$nav-link-hover-color", navsUrl),
            "tableBg" => ("$table-bg", tablesUrl),
            "tableStripedBg" => ("$table-striped-bg", tablesUrl),
            "tableHoverBg" => ("$table-hover-bg", tablesUrl),
            "tooltipBg" => ("$tooltip-bg", "https://getbootstrap.com/docs/5.3/components/tooltips/"),
            "popoverBg" => ("$popover-bg", "https://getbootstrap.com/docs/5.3/components/popovers/"),
            "boxShadowSm" => ("$box-shadow-sm", customizeUrl),
            "boxShadow" => ("$box-shadow", customizeUrl),
            "boxShadowLg" => ("$box-shadow-lg", customizeUrl),
            "enableTransitions" => ("$enable-transitions", customizeUrl),
            "transitionBase" => ("$transition-base", customizeUrl),
            "transitionFade" => ("$transition-fade", customizeUrl),
            "transitionCollapse" => ("$transition-collapse", customizeUrl),
            "utilitiesMapRaw" => ("$utilities", utilitiesUrl),
            _ => (string.Empty, customizeUrl)
        };
    }
}

