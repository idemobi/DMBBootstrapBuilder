    function safeGetLegacyStoredConfig() {
        try {
            const value = window.localStorage.getItem(legacyStorageKey);
            return value ? JSON.parse(value) : null;
        } catch {
            return null;
        }
    }

    function safeGetProfiles() {
        try {
            const value = window.localStorage.getItem(profilesStorageKey);
            const parsed = value ? JSON.parse(value) : {};
            if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return {};
            return parsed;
        } catch {
            return {};
        }
    }

    function saveProfiles(profiles) {
        window.localStorage.setItem(profilesStorageKey, JSON.stringify(profiles));
    }

    function getActiveProfileName() {
        return window.localStorage.getItem(activeProfileStorageKey) || "";
    }

    function setActiveProfileName(name) {
        if (!name) window.localStorage.removeItem(activeProfileStorageKey);
        else window.localStorage.setItem(activeProfileStorageKey, name);
    }
    function hasActiveProfile() {
        const activeName = getActiveProfileName();
        if (!activeName) return false;
        const profiles = safeGetProfiles();
        return Boolean(profiles[activeName]);
    }

    function normalizeProfileName(rawName) {
        return String(rawName || "").trim();
    }

    function normalizeConfig(rawConfig) {
        const source = rawConfig && typeof rawConfig === "object" ? rawConfig : {};
        return Object.assign({}, defaultConfig, source);
    }

    function refreshProfileSelect(selectedName) {
        if (!ui.profileSelect) return;
        const profiles = safeGetProfiles();
        const names = Object.keys(profiles).sort((a, b) => a.localeCompare(b));
        ui.profileSelect.innerHTML = "";
        const noConfigOption = document.createElement("option");
        noConfigOption.value = "";
        noConfigOption.textContent = "No config";
        noConfigOption.selected = !selectedName;
        ui.profileSelect.appendChild(noConfigOption);
        names.forEach(function (name) {
            const option = document.createElement("option");
            option.value = name;
            option.textContent = name;
            if (name === selectedName) option.selected = true;
            ui.profileSelect.appendChild(option);
        });
        ui.profileSelect.classList.toggle("dmb-profile-select-empty", !ui.profileSelect.value);
    }

    function setButtonEnabled(id, enabled) {
        const button = document.getElementById(id);
        if (!button) return;
        button.disabled = !enabled;
    }

    function updateProfileActionState() {
        const active = hasActiveProfile();
        const inputName = normalizeProfileName(ui.profileNameInput ? ui.profileNameInput.value : "");
        const hasInputName = inputName.length > 0;

        setButtonEnabled("saveAsProfile", hasInputName);
        setButtonEnabled("saveCurrentProfile", active);
        setButtonEnabled("restoreProfile", active);
        setButtonEnabled("deleteProfile", active);

        const unloadButton = document.getElementById("unloadProfile");
        if (unloadButton) {
            unloadButton.textContent = active ? "Unload profile" : "Reset to default";
            unloadButton.classList.toggle("btn-outline-danger", active);
            unloadButton.classList.toggle("btn-outline-warning", !active);
        }
    }

    function toConfig() {
        const c = {};
        ids.forEach(function (id) {
            if (!form[id]) return;
            if (id === "liveOverrideEnabled") c[id] = form[id].checked;
            else if (["borderRadiusPx", "borderRadiusSmPx", "borderRadiusLgPx", "borderRadiusXlPx", "borderRadiusPillPx", "borderWidthPx", "fontScalePercent", "headingsFontWeight", "focusRingWidthPx", "btnBorderRadiusPx", "cardBorderWidthPx", "cardBorderRadiusPx", "enableTransitions", "bpXs", "bpSm", "bpMd", "bpLg", "bpXl", "bpXxl", "cwSm", "cwMd", "cwLg", "cwXl", "cwXxl"].includes(id)) c[id] = Number.parseInt(form[id].value, 10);
            else if (["headingsLineHeight", "leadFontSize", "smallFontSize", "modalBackdropOpacity", "borderColorTranslucent", "inputBtnPaddingYRem", "inputBtnPaddingXRem", "btnPaddingYRem", "btnPaddingXRem", "spacerRem", "gridGutterRem", "spacer0", "spacer1", "spacer2", "spacer3", "spacer4", "spacer5"].includes(id)) c[id] = Number.parseFloat(form[id].value);
            else c[id] = form[id].value;
        });
        return c;
    }

    function pxToRem(value) { return (value / 16).toFixed(3).replace(/0+$/, "").replace(/\.$/, "") + "rem"; }

    function formatValueLabel(id, value) {
        if (value === null || value === undefined) return "";

        if (id.endsWith("Color") || id === "borderColor" || id === "cardBg" || id === "modalContentBg" || id === "dropdownBg" || id === "dropdownLinkHoverBg" || id === "tableBg" || id === "tooltipBg" || id === "popoverBg") {
            return String(value);
        }
        if (id === "fontScalePercent" || id === "lineHeight") {
            return id === "fontScalePercent" ? String(value) + "%" : (Number(value) / 100).toFixed(2);
        }
        if (id === "borderColorTranslucent" || id === "modalBackdropOpacity") {
            return Number(value).toFixed(2);
        }
        if (id === "spacerRem" || id === "gridGutterRem" || id.startsWith("spacer")) {
            return String(value) + "rem";
        }
        if (id.startsWith("bp") || id.startsWith("cw") || id.endsWith("Px") || id === "focusRingWidthPx" || id === "borderWidthPx") {
            return String(value) + "px";
        }
        if (id === "leadFontSize" || id === "smallFontSize" || id.endsWith("Rem")) {
            return String(value) + "rem";
        }
        if (id === "liveOverrideEnabled") {
            return value ? "on" : "off";
        }
        return String(value);
    }

    function updateValueLabels(config) {
        ids.forEach(function (id) {
            const label = valueLabels[id];
            if (!label) return;
            label.textContent = formatValueLabel(id, config[id]);
        });
    }

    function syncCardModeUi() {
        ["cardBg", "cardBorderColor", "cardBorderWidthPx", "cardBorderRadiusPx"].forEach(function (id) {
            const modeField = form[id + "Mode"];
            const valueField = form[id];
            if (!modeField || !valueField) return;
            const mode = String(modeField.value || "custom");
            const isReadOnly = mode === "inherit" || (id === "cardBorderRadiusPx" && mode === "formula");
            valueField.disabled = isReadOnly;
        });
    }

    function resolveCardValues(config) {
        const cardBg = config.cardBgMode === "inherit" ? config.bodyBgColor : config.cardBg;
        const cardBorderColor = config.cardBorderColorMode === "custom" ? config.cardBorderColor : config.borderColor;
        const cardBorderWidthPx = config.cardBorderWidthPxMode === "custom" ? config.cardBorderWidthPx : config.borderWidthPx;
        let cardBorderRadiusPx = config.borderRadiusPx;
        if (config.cardBorderRadiusPxMode === "custom") {
            cardBorderRadiusPx = config.cardBorderRadiusPx;
        } else if (config.cardBorderRadiusPxMode === "formula") {
            cardBorderRadiusPx = Math.max(0, config.borderRadiusPx - cardBorderWidthPx);
        }
        return { cardBg, cardBorderColor, cardBorderWidthPx, cardBorderRadiusPx };
    }

