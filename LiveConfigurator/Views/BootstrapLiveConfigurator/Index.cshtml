    function ensureGoogleFontLoaded(fontName) {
        if (!fontName || !String(fontName).trim()) return;
        const normalized = String(fontName).trim();
        const id = "dmb-gfont-" + normalized.toLowerCase().replace(/[^a-z0-9]+/g, "-");
        if (document.getElementById(id)) return;
        const link = document.createElement("link");
        link.id = id;
        link.rel = "stylesheet";
        link.href = "https://fonts.googleapis.com/css2?family=" + encodeURIComponent(normalized).replace(/%20/g, "+") + ":wght@300;400;500;600;700&display=swap";
        document.head.appendChild(link);
    }

    function resolveBodyFontFamily(config) {
        if (config.googleBodyFont && String(config.googleBodyFont).trim()) {
            return "\"" + String(config.googleBodyFont).trim() + "\", sans-serif";
        }
        return config.fontFamilySansSerif;
    }

    function resolveHeadingFontFamily(config) {
        if (config.googleHeadingFont && String(config.googleHeadingFont).trim()) {
            return "\"" + String(config.googleHeadingFont).trim() + "\", serif";
        }
        return config.headingsFontFamily;
    }

    function clearCssVars() {
        const root = document.documentElement;
        [
            "--bs-primary", "--bs-secondary", "--bs-success", "--bs-danger", "--bs-warning", "--bs-info",
            "--bs-link-color", "--bs-border-color", "--bs-border-color-translucent", "--bs-border-radius", "--bs-border-width",
            "--bs-card-border-color", "--bs-card-border-width", "--bs-card-border-radius",
            "--bs-primary-rgb", "--bs-secondary-rgb", "--bs-success-rgb", "--bs-danger-rgb", "--bs-warning-rgb", "--bs-info-rgb",
            "--bs-body-font-family"
        ].forEach(n => root.style.removeProperty(n));
        root.style.removeProperty("font-size");
        root.style.removeProperty("line-height");

        const spacingGridRow = document.getElementById("spacingGridRow");
        if (spacingGridRow) spacingGridRow.style.removeProperty("--bs-gutter-x");

        [
            "dmb-live-configurator-component-overrides",
            "dmb-bootstrap-live-dynamic-colors",
            "dmb-live-configurator-preview-typography-fallback",
            "dmb-live-configurator-preview-cards-fallback"
        ].forEach(function (styleId) {
            const styleTag = document.getElementById(styleId);
            if (styleTag) styleTag.remove();
        });
    }

    function applyConfig(config) {
        syncCardModeUi();
        updateValueLabels(config);

        if (config.liveOverrideEnabled) applyCssVars(config); else clearCssVars();
        if (!config.liveOverrideEnabled) applyPreviewFallbackColors(config);
        if (!config.liveOverrideEnabled) applyPreviewFallbackTypography(config);
        if (!config.liveOverrideEnabled) applyPreviewFallbackCards(config);
        updateOutputs(config);
        const activeName = getActiveProfileName();
        if (!activeName) {
            ui.emptyStateText.textContent = "No profile loaded. You are editing a temporary working state.";
        } else {
            ui.emptyStateText.textContent = config.liveOverrideEnabled
                ? "Active profile: " + activeName + " (site-wide override enabled)."
                : "Active profile: " + activeName + " (override disabled, values kept).";
        }
    }

    function setForm(config) {
        ids.forEach(function (id) {
            if (!form[id]) return;
            if (id === "liveOverrideEnabled") form[id].checked = Boolean(config[id]);
            else form[id].value = String(config[id]);
        });
    }

    function refreshEmptyState() {
        const profiles = safeGetProfiles();
        const profileCount = Object.keys(profiles).length;
        const activeName = getActiveProfileName();
        if (!activeName) {
            ui.emptyStateText.textContent = profileCount === 0
                ? "No local profile is stored yet."
                : "No profile loaded (" + profileCount + " stored profile(s)).";
            return;
        }
        const activeConfig = profiles[activeName];
        if (!activeConfig) {
            ui.emptyStateText.textContent = "Active profile missing. Choose a profile to load.";
            return;
        }
        ui.emptyStateText.textContent = activeConfig.liveOverrideEnabled === false
            ? "Active profile: " + activeName + " (override disabled)."
            : "Active profile: " + activeName + " (override enabled site-wide).";
    }

    function saveAsProfile() {
        const currentName = ui.profileNameInput ? ui.profileNameInput.value : "";
        const name = normalizeProfileName(currentName);
        if (!name) {
            window.alert("Please enter a profile name.");
            return;
        }
        const profiles = safeGetProfiles();
        if (profiles[name] && !window.confirm("A profile with this name already exists. Overwrite it?")) {
            return;
        }
        profiles[name] = normalizeConfig(toConfig());
        saveProfiles(profiles);
        setActiveProfileName(name);
        refreshProfileSelect(name);
        if (ui.profileNameInput) ui.profileNameInput.value = name;
        refreshEmptyState();
        updateProfileActionState();
    }

    function saveCurrentProfile() {
        const activeName = getActiveProfileName();
        if (!activeName) {
            return;
        }
        const profiles = safeGetProfiles();
        const requestedName = normalizeProfileName(ui.profileNameInput ? ui.profileNameInput.value : "");
        const targetName = requestedName || activeName;
        if (targetName !== activeName) {
            if (profiles[targetName] && !window.confirm("A profile with this name already exists. Overwrite it?")) {
                return;
            }
            delete profiles[activeName];
        }
        profiles[targetName] = normalizeConfig(toConfig());
        saveProfiles(profiles);
        setActiveProfileName(targetName);
        if (ui.profileNameInput) ui.profileNameInput.value = targetName;
        refreshProfileSelect(targetName);
        refreshEmptyState();
        updateProfileActionState();
    }

    function loadProfileByName(selected) {
        const profiles = safeGetProfiles();
        const selectedConfig = normalizeConfig(profiles[selected]);
        if (!selectedConfig) {
            window.alert("Selected profile was not found.");
            refreshProfileSelect("");
            refreshEmptyState();
            return;
        }
        setActiveProfileName(selected);
        setForm(selectedConfig);
        applyConfig(selectedConfig);
        if (ui.profileNameInput) ui.profileNameInput.value = selected;
        refreshProfileSelect(selected);
        refreshEmptyState();
        updateProfileActionState();
    }

    function unloadProfile() {
        const wasActive = hasActiveProfile();
        setActiveProfileName("");
        setForm(defaultConfig);
        applyConfig(defaultConfig);
        if (ui.profileNameInput) ui.profileNameInput.value = wasActive ? "" : (ui.profileNameInput.value || "");
        refreshProfileSelect("");
        refreshEmptyState();
        updateProfileActionState();
    }

    function restoreFromLastSave() {
        const activeName = getActiveProfileName();
        if (!activeName) return;
        const profiles = safeGetProfiles();
        const config = normalizeConfig(profiles[activeName]);
        if (!config) return;
        setForm(config);
        applyConfig(config);
        refreshEmptyState();
    }

    function deleteProfile() {
        const activeName = getActiveProfileName();
        if (!activeName) return;
        if (!window.confirm("Delete profile '" + activeName + "'? This action cannot be undone.")) {
            return;
        }
        const profiles = safeGetProfiles();
        delete profiles[activeName];
        saveProfiles(profiles);
        setActiveProfileName("");
        setForm(defaultConfig);
        applyConfig(defaultConfig);
        if (ui.profileNameInput) ui.profileNameInput.value = "";
        refreshProfileSelect("");
        refreshEmptyState();
        updateProfileActionState();
    }
    function togglePreviewTheme() {
        previewTheme = previewTheme === "light" ? "dark" : "light";
        document.documentElement.setAttribute("data-bs-theme", previewTheme);
        if (ui.previewThemeToggle) ui.previewThemeToggle.textContent = previewTheme === "light" ? "Theme: Light" : "Theme: Dark";
    }
    function initPopovers() {
        const popoverTargets = document.querySelectorAll('[data-bs-toggle="popover"]');
        popoverTargets.forEach(function (el) {
            if (window.bootstrap && window.bootstrap.Popover) {
                if (!el.getAttribute("data-dmb-popover-bound")) {
                    new window.bootstrap.Popover(el);
                    el.setAttribute("data-dmb-popover-bound", "1");
                }
            } else {
                const content = el.getAttribute("data-bs-content");
                if (content && !el.getAttribute("title")) {
                    el.setAttribute("title", content);
                }
            }
        });
    }

    ids.forEach(function (id) {
        if (!form[id]) return;
        ["input", "change"].forEach(function (eventName) {
            form[id].addEventListener(eventName, function () {
                const config = toConfig();
                applyConfig(config);
                if (id === "liveOverrideEnabled") {
                    const activeName = getActiveProfileName();
                    if (activeName) {
                        const profiles = safeGetProfiles();
                        if (profiles[activeName]) {
                            profiles[activeName].liveOverrideEnabled = config.liveOverrideEnabled;
                            saveProfiles(profiles);
                        }
                    }
                }
                refreshEmptyState();
            });
        });
    });

    document.querySelectorAll("[data-reset-target]").forEach(function (button) {
        button.addEventListener("click", function () {
            const target = button.getAttribute("data-reset-target");
            if (!target || !form[target]) return;
            if (target === "liveOverrideEnabled") form[target].checked = Boolean(defaultConfig[target]);
            else form[target].value = String(defaultConfig[target]);
            applyConfig(toConfig());
        });
    });

    const saveAsProfileButton = document.getElementById("saveAsProfile");
    const saveCurrentProfileButton = document.getElementById("saveCurrentProfile");
    const restoreProfileButton = document.getElementById("restoreProfile");
    const unloadProfileButton = document.getElementById("unloadProfile");
    const deleteProfileButton = document.getElementById("deleteProfile");
    if (saveAsProfileButton) saveAsProfileButton.addEventListener("click", saveAsProfile);
    if (saveCurrentProfileButton) saveCurrentProfileButton.addEventListener("click", saveCurrentProfile);
    if (restoreProfileButton) restoreProfileButton.addEventListener("click", restoreFromLastSave);
    if (unloadProfileButton) unloadProfileButton.addEventListener("click", unloadProfile);
    if (deleteProfileButton) deleteProfileButton.addEventListener("click", deleteProfile);
    if (ui.profileNameInput) {
        ui.profileNameInput.addEventListener("input", updateProfileActionState);
        ui.profileNameInput.addEventListener("change", updateProfileActionState);
    }
    if (ui.profileSelect) {
        ui.profileSelect.addEventListener("change", function () {
            const selected = normalizeProfileName(ui.profileSelect.value);
            if (!selected) {
                unloadProfile();
                return;
            }
            loadProfileByName(selected);
            updateProfileActionState();
        });
    }
    if (ui.previewThemeToggle) ui.previewThemeToggle.addEventListener("click", togglePreviewTheme);
    initPopovers();
    window.setTimeout(initPopovers, 250);
    refreshProfileSelect(getActiveProfileName());
    const activeName = getActiveProfileName();
    const profiles = safeGetProfiles();
    const legacyRaw = safeGetLegacyStoredConfig();
    if (!activeName && Object.keys(profiles).length === 0 && legacyRaw) {
        const legacy = normalizeConfig(legacyRaw);
        profiles["Migrated profile"] = legacy;
        saveProfiles(profiles);
        setActiveProfileName("Migrated profile");
        refreshProfileSelect("Migrated profile");
        if (ui.profileNameInput) ui.profileNameInput.value = "Migrated profile";
        setForm(legacy);
        applyConfig(legacy);
    } else if (activeName && profiles[activeName]) {
        const normalizedActive = normalizeConfig(profiles[activeName]);
        setForm(normalizedActive);
        applyConfig(normalizedActive);
        refreshProfileSelect(activeName);
        if (ui.profileNameInput) ui.profileNameInput.value = activeName;
    } else {
        setForm(defaultConfig);
        applyConfig(defaultConfig);
    }
    refreshEmptyState();
    updateProfileActionState();
})();
</script>
