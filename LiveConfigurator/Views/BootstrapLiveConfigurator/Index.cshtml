        const secondaryDisabled = hexToRgba(config.secondaryColor, 0.65);
        const successDisabled = hexToRgba(config.successColor, 0.65);
        const dangerDisabled = hexToRgba(config.dangerColor, 0.65);
        const resolvedCard = resolveCardValues(config);

        styleTag.textContent = [
            "#dmbPreviewScope .btn-primary, #previewColors .btn-primary{background-color:" + config.primaryColor + " !important;border-color:" + config.primaryColor + " !important;color:#fff !important;}",
            "#saveAsProfile{background-color:" + config.primaryColor + " !important;border-color:" + config.primaryColor + " !important;color:#fff !important;}",
