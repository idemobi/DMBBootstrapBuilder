@using DMBBootstrapBuilder
@using DMBComponentBuilder
@using DMBPageBuilder
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Bootstrap Live Configurator";
    Layout = "_Layout";
}

<div class="container py-4 d-grid gap-4">
    <h1 class="h3 mb-0">Bootstrap Live Configurator</h1>

    @using (Html.CardBuilder().WithTitle("About this module", TitleLevel.Three, IconStruct.Bootstrap("bi-info-circle")).Begin())
    {
        <p class="mb-2 text-muted">
            Configure Bootstrap tokens with immediate feedback. Each tab provides dedicated controls and a focused preview.
            The global preview below summarizes all active settings.
        </p>
        <div class="form-check form-switch mb-1">
            <input class="form-check-input" type="checkbox" role="switch" id="liveOverrideEnabled" checked />
            <label class="form-check-label" for="liveOverrideEnabled">Enable live Bootstrap style override site-wide</label>
        </div>
        <small class="text-muted">When disabled, values stay saved but no visual override is applied.</small>
    }

    @using (Html.CardBuilder().WithTitle("Configuration by group", TitleLevel.Three, IconStruct.Bootstrap("bi-sliders2")).Begin())
    {
        <div class="d-flex justify-content-end mb-2">
            <button id="togglePreviewTheme" type="button" class="btn btn-sm btn-outline-secondary">Theme: Light</button>
        </div>
        <div id="dmbConfiguratorTabsScope">
        @using (Html.TabAreaBuilder().Tabs().WithContentClasses("pt-3").Begin())
        {
            @using (Html.TabBlockBuilder().WithTitle("Colors").WithIcon(IconStruct.Bootstrap("bi-palette")).Active().Begin())
            {
                <div class="row g-4">
                    <div class="col-12 col-lg-6">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 dmb-setting-table">
                                <colgroup>
                                    <col class="dmb-col-label" />
                                    <col class="dmb-col-mode" />
                                    <col class="dmb-col-field" />
                                    <col class="dmb-col-value" />
                                    <col class="dmb-col-reset" />
                                    <col class="dmb-col-info" />
                                </colgroup>
                                <tbody>
                                @RenderSettingRow("Primary", "primaryColor", "color", "#0d6efd", "Main accent color for actions and highlights.")
                                @RenderSettingRow("Secondary", "secondaryColor", "color", "#6c757d", "Secondary accent for alternate actions.")
                                @RenderSettingRow("Success", "successColor", "color", "#198754", "Success semantic color.")
                                @RenderSettingRow("Danger", "dangerColor", "color", "#dc3545", "Danger/error semantic color.")
                                @RenderSettingRow("Warning", "warningColor", "color", "#ffc107", "Warning semantic color.")
                                @RenderSettingRow("Info", "infoColor", "color", "#0dcaf0", "Info semantic color.")
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <section id="previewColors" class="card">
                            <div class="card-body d-grid gap-2">
                                <h3 class="h6 mb-1">Preview - Colors</h3>
                                <div class="d-flex flex-wrap gap-2">
                                    <button class="btn btn-primary">Primary</button>
                                    <button class="btn btn-secondary">Secondary</button>
                                    <button class="btn btn-success">Success</button>
                                    <button class="btn btn-danger">Danger</button>
                                    <button class="btn btn-warning">Warning</button>
                                    <button class="btn btn-info">Info</button>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button class="btn btn-primary" disabled>Primary disabled</button>
                                    <button class="btn btn-secondary" disabled>Secondary disabled</button>
                                    <button class="btn btn-outline-primary" disabled>Outline disabled</button>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge text-bg-primary">Primary</span>
                                    <span class="badge text-bg-secondary">Secondary</span>
                                    <span class="badge text-bg-success">Success</span>
                                    <span class="badge text-bg-danger">Danger</span>
                                    <span class="badge text-bg-warning">Warning</span>
                                    <span class="badge text-bg-info">Info</span>
                                </div>
                                <div class="table-responsive mt-2">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                        <tr>
                                            <th>Variant</th>
                                            <th>Base</th>
                                            <th>Subtle BG</th>
                                            <th>Subtle Border</th>
                                            <th>Emphasis text</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr>
                                            <td>Primary</td>
                                            <td><span class="badge dmb-variant-badge dmb-variant-primary-base">Primary</span></td>
                                            <td><span class="dmb-variant-chip dmb-variant-primary-subtle-bg">bg</span></td>
                                            <td><span class="dmb-variant-chip dmb-variant-primary-subtle-border">border</span></td>
                                            <td><span class="dmb-variant-text dmb-variant-primary-emphasis">emphasis</span></td>
                                        </tr>
                                        <tr>
                                            <td>Secondary</td>
                                            <td><span class="badge dmb-variant-badge dmb-variant-secondary-base">Secondary</span></td>
                                            <td><span class="dmb-variant-chip dmb-variant-secondary-subtle-bg">bg</span></td>
                                            <td><span class="dmb-variant-chip dmb-variant-secondary-subtle-border">border</span></td>
                                            <td><span class="dmb-variant-text dmb-variant-secondary-emphasis">emphasis</span></td>
                                        </tr>
                                        <tr>
                                            <td>Success</td>
                                            <td><span class="badge dmb-variant-badge dmb-variant-success-base">Success</span></td>
                                            <td><span class="dmb-variant-chip dmb-variant-success-subtle-bg">bg</span></td>
                                            <td><span class="dmb-variant-chip dmb-variant-success-subtle-border">border</span></td>
                                            <td><span class="dmb-variant-text dmb-variant-success-emphasis">emphasis</span></td>
                                        </tr>
                                        <tr>
                                            <td>Danger</td>
                                            <td><span class="badge dmb-variant-badge dmb-variant-danger-base">Danger</span></td>
                                            <td><span class="dmb-variant-chip dmb-variant-danger-subtle-bg">bg</span></td>
                                            <td><span class="dmb-variant-chip dmb-variant-danger-subtle-border">border</span></td>
                                            <td><span class="dmb-variant-text dmb-variant-danger-emphasis">emphasis</span></td>
                                        </tr>
                                        <tr>
                                            <td>Warning</td>
                                            <td><span class="badge dmb-variant-badge dmb-variant-warning-base">Warning</span></td>
                                            <td><span class="dmb-variant-chip dmb-variant-warning-subtle-bg">bg</span></td>
                                            <td><span class="dmb-variant-chip dmb-variant-warning-subtle-border">border</span></td>
                                            <td><span class="dmb-variant-text dmb-variant-warning-emphasis">emphasis</span></td>
                                        </tr>
                                        <tr>
                                            <td>Info</td>
                                            <td><span class="badge dmb-variant-badge dmb-variant-info-base">Info</span></td>
                                            <td><span class="dmb-variant-chip dmb-variant-info-subtle-bg">bg</span></td>
                                            <td><span class="dmb-variant-chip dmb-variant-info-subtle-border">border</span></td>
                                            <td><span class="dmb-variant-text dmb-variant-info-emphasis">emphasis</span></td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            }

            @using (Html.TabBlockBuilder().WithTitle("Typography").WithIcon(IconStruct.Bootstrap("bi-fonts")).Begin())
            {
                <div class="row g-4">
                    <div class="col-12 col-lg-6 d-grid gap-3">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 dmb-setting-table">
                                <colgroup>
                                    <col class="dmb-col-label" />
                                    <col class="dmb-col-mode" />
                                    <col class="dmb-col-field" />
                                    <col class="dmb-col-value" />
                                    <col class="dmb-col-reset" />
                                    <col class="dmb-col-info" />
                                </colgroup>
                                <tbody>
                                @RenderSettingRow("Font scale", "fontScalePercent", "range", "100", "Base font size scaling (%).", "85", "140")
                                @RenderSettingRow("Line height", "lineHeight", "range", "150", "Default text line-height (%).", "110", "220")
                                @RenderSettingRow("Sans font family", "fontFamilySansSerif", "text", "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif", "Bootstrap $font-family-sans-serif stack.")
                                @RenderSettingRow("Google body font", "googleBodyFont", "text", "", "Optional Google Font for body text (test mode).")
                                @RenderSettingRow("Headings font family", "headingsFontFamily", "text", "inherit", "Bootstrap $headings-font-family.")
                                @RenderSettingRow("Google heading font", "googleHeadingFont", "text", "", "Optional Google Font for headings (test mode).")
                                @RenderSettingRow("Headings font weight", "headingsFontWeight", "number", "500", "Bootstrap $headings-font-weight.", min: "100", max: "900", step: "100")
                                @RenderSettingRow("Headings line-height", "headingsLineHeight", "number", "1.2", "Bootstrap $headings-line-height.", min: "0.8", max: "2", step: "0.05")
                                @RenderSettingRow("Lead font size", "leadFontSize", "number", "1.25", "Bootstrap $lead-font-size (rem).", min: "0.8", max: "2.5", step: "0.05")
                                @RenderSettingRow("Small font size", "smallFontSize", "number", "0.875", "Bootstrap $small-font-size (rem).", min: "0.6", max: "1.2", step: "0.025")
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <section id="previewTypography" class="card">
                            <div class="card-body">
                                <h3 class="h6 mb-2">Preview - Typography</h3>
                                <p class="mb-2">The quick brown fox jumps over the lazy dog.</p>
                                <p class="lead mb-2 dmb-preview-lead">Lead text preview sample.</p>
                                <p class="mb-2"><small class="dmb-preview-small">Small text preview sample.</small></p>
                                <p class="text-muted mb-2">Secondary text sample for readability check.</p>
                                <p class="mb-0"><strong>Headings, paragraph rhythm, and body scaling should react instantly.</strong></p>
                            </div>
                        </section>
                    </div>
                </div>
            }

            @using (Html.TabBlockBuilder().WithTitle("Borders & Layout").WithIcon(IconStruct.Bootstrap("bi-bounding-box-circles")).Begin())
            {
                <div class="row g-4">
                    <div class="col-12 col-lg-6 d-grid gap-3">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 dmb-setting-table">
                                <colgroup>
                                    <col class="dmb-col-label" />
                                    <col class="dmb-col-mode" />
                                    <col class="dmb-col-field" />
                                    <col class="dmb-col-value" />
                                    <col class="dmb-col-reset" />
                                    <col class="dmb-col-info" />
                                </colgroup>
                                <tbody>
                                @RenderSettingRow("Border radius", "borderRadiusPx", "range", "8", "Rounded corners base size in px.", "0", "28")
                                @RenderSettingRow("Border width", "borderWidthPx", "range", "1", "Default border width in px.", "0", "6")
                                @RenderSettingRow("Border color", "borderColor", "color", "#dee2e6", "Bootstrap $border-color.")
                                @RenderSettingRow("Border translucent", "borderColorTranslucent", "range", "0.175", "Bootstrap $border-color-translucent alpha (0..1).", min: "0", max: "1", step: "0.01")
                                @RenderSettingRow("Radius sm", "borderRadiusSmPx", "number", "4", "Small radius for compact controls/chips.", min: "0", max: "24", step: "1")
                                @RenderSettingRow("Radius lg", "borderRadiusLgPx", "number", "10", "Large radius for prominent controls/cards.", min: "0", max: "32", step: "1")
                                @RenderSettingRow("Radius xl", "borderRadiusXlPx", "number", "16", "Extra large radius for hero blocks/callouts.", min: "0", max: "40", step: "1")
                                @RenderSettingRow("Radius pill", "borderRadiusPillPx", "number", "50", "Pill radius for capsule buttons/badges.", min: "0", max: "200", step: "1")
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <section id="previewBorders" class="card">
                            <div class="card-body">
                                <h3 class="h6 mb-2">Preview - Borders</h3>
                                <div class="p-3 border rounded mb-2 dmb-preview-border-card">Card sample with configurable radius and border width.</div>
                                <div class="p-3 border rounded mb-2 dmb-preview-border-translucent">Translucent border sample.</div>
                                <div class="d-grid gap-2 mb-2">
                                    <input class="form-control rounded dmb-preview-border-input" value="Input sample" />
                                    <button class="btn btn-primary dmb-preview-border-btn">Button sample</button>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge text-bg-secondary dmb-radius-sm">Radius sm</span>
                                    <span class="badge text-bg-secondary dmb-radius-lg">Radius lg</span>
                                    <span class="badge text-bg-secondary dmb-radius-xl">Radius xl</span>
                                    <span class="badge text-bg-secondary dmb-radius-pill px-3">Radius pill</span>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            }

            @using (Html.TabBlockBuilder().WithTitle("Spacing & Grid").WithIcon(IconStruct.Bootstrap("bi-grid-3x3-gap")).Begin())
            {
                <div class="row g-4">
                    <div class="col-12 col-lg-6 d-grid gap-3">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 dmb-setting-table">
                                <colgroup>
                                    <col class="dmb-col-label" />
                                    <col class="dmb-col-mode" />
                                    <col class="dmb-col-field" />
                                    <col class="dmb-col-value" />
                                    <col class="dmb-col-reset" />
                                    <col class="dmb-col-info" />
                                </colgroup>
                                <tbody>
                                @RenderSettingRow("Base spacer", "spacerRem", "range", "1", "Bootstrap $spacer (rem).", "0.25", "2", "0.05")
                                @RenderSettingRow("Grid gutter", "gridGutterRem", "range", "1.5", "Bootstrap $grid-gutter-width (rem).", "0.5", "3", "0.05")
                                @RenderSettingRow("Spacer 0", "spacer0", "number", "0", "$spacers map level 0.", step: "0.05")
                                @RenderSettingRow("Spacer 1", "spacer1", "number", "0.25", "$spacers map level 1.", step: "0.05")
                                @RenderSettingRow("Spacer 2", "spacer2", "number", "0.5", "$spacers map level 2.", step: "0.05")
                                @RenderSettingRow("Spacer 3", "spacer3", "number", "1", "$spacers map level 3.", step: "0.05")
                                @RenderSettingRow("Spacer 4", "spacer4", "number", "1.5", "$spacers map level 4.", step: "0.05")
                                @RenderSettingRow("Spacer 5", "spacer5", "number", "3", "$spacers map level 5.", step: "0.05")
                                @RenderSettingRow("Breakpoint xs", "bpXs", "number", "0", "$grid-breakpoints xs (px).", min: "0", step: "1")
                                @RenderSettingRow("Breakpoint sm", "bpSm", "number", "576", "$grid-breakpoints sm (px).", min: "0", step: "1")
                                @RenderSettingRow("Breakpoint md", "bpMd", "number", "768", "$grid-breakpoints md (px).", min: "0", step: "1")
                                @RenderSettingRow("Breakpoint lg", "bpLg", "number", "992", "$grid-breakpoints lg (px).", min: "0", step: "1")
                                @RenderSettingRow("Breakpoint xl", "bpXl", "number", "1200", "$grid-breakpoints xl (px).", min: "0", step: "1")
                                @RenderSettingRow("Breakpoint xxl", "bpXxl", "number", "1400", "$grid-breakpoints xxl (px).", min: "0", step: "1")
                                @RenderSettingRow("Container sm", "cwSm", "number", "540", "$container-max-widths sm (px).", min: "0", step: "1")
                                @RenderSettingRow("Container md", "cwMd", "number", "720", "$container-max-widths md (px).", min: "0", step: "1")
                                @RenderSettingRow("Container lg", "cwLg", "number", "960", "$container-max-widths lg (px).", min: "0", step: "1")
                                @RenderSettingRow("Container xl", "cwXl", "number", "1140", "$container-max-widths xl (px).", min: "0", step: "1")
                                @RenderSettingRow("Container xxl", "cwXxl", "number", "1320", "$container-max-widths xxl (px).", min: "0", step: "1")
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <section id="previewSpacing" class="card">
                            <div class="card-body">
                                <h3 class="h6 mb-2">Preview - Spacing/Grid</h3>
                                <div class="container border rounded p-2">
                                    <div class="row" id="spacingGridRow">
                                        <div class="col-4"><div class="border rounded p-2 text-center">A</div></div>
                                        <div class="col-4"><div class="border rounded p-2 text-center">B</div></div>
                                        <div class="col-4"><div class="border rounded p-2 text-center">C</div></div>
                                    </div>
                                </div>
                                <small class="text-muted d-block mt-2">Gutter and base spacing should update this grid block.</small>
                            </div>
                        </section>
                    </div>
                </div>
            }

            @using (Html.TabBlockBuilder().WithTitle("Links & Focus").WithIcon(IconStruct.Bootstrap("bi-link-45deg")).Begin())
            {
                <div class="row g-4">
                    <div class="col-12 col-lg-6 d-grid gap-3">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 dmb-setting-table">
                                <colgroup>
                                    <col class="dmb-col-label" />
                                    <col class="dmb-col-mode" />
                                    <col class="dmb-col-field" />
                                    <col class="dmb-col-value" />
                                    <col class="dmb-col-reset" />
                                    <col class="dmb-col-info" />
                                </colgroup>
                                <tbody>
                                @RenderSettingRow("Link color", "linkColor", "color", "#0d6efd", "$link-color.")
                                @RenderSettingRow("Link hover color", "linkHoverColor", "color", "#0a58ca", "$link-hover-color.")
                                @RenderSettingRow("Link decoration", "linkDecoration", "text", "underline", "$link-decoration (underline/none).")
                                @RenderSettingRow("Focus ring color", "focusRingColor", "text", "rgba(13,110,253,.25)", "$focus-ring-color.")
                                @RenderSettingRow("Focus ring width", "focusRingWidthPx", "number", "4", "$focus-ring-width (px).", min: "0", max: "12", step: "1")
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <section class="card dmb-preview-advanced">
                            <div class="card-body d-grid gap-3">
                                <h3 class="h6 mb-0">Preview - Links & Focus</h3>
                                <div class="d-flex flex-wrap gap-3 align-items-center">
                                    <a href="#" class="dmb-preview-link">Sample link</a>
                                    <button class="btn btn-primary dmb-preview-btn">Button sample</button>
                                </div>
                                <div class="p-2 border rounded dmb-preview-popover" data-bs-toggle="popover" data-bs-trigger="hover focus" data-bs-content="Popover background preview target.">Hover here for popover</div>
                            </div>
                        </section>
                    </div>
                </div>
            }

            @using (Html.TabBlockBuilder().WithTitle("Forms & Buttons").WithIcon(IconStruct.Bootstrap("bi-input-cursor-text")).Begin())
            {
                <div class="row g-4">
                    <div class="col-12 col-lg-6 d-grid gap-3">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 dmb-setting-table">
                                <colgroup>
                                    <col class="dmb-col-label" />
                                    <col class="dmb-col-mode" />
                                    <col class="dmb-col-field" />
                                    <col class="dmb-col-value" />
                                    <col class="dmb-col-reset" />
                                    <col class="dmb-col-info" />
                                </colgroup>
                                <tbody>
                                @RenderSettingRow("Input bg", "inputBg", "color", "#ffffff", "$input-bg.")
                                @RenderSettingRow("Input color", "inputColor", "color", "#212529", "$input-color.")
                                @RenderSettingRow("Input border", "inputBorderColor", "color", "#ced4da", "$input-border-color.")
                                @RenderSettingRow("Input focus border", "inputFocusBorderColor", "color", "#86b7fe", "$input-focus-border-color.")
                                @RenderSettingRow("Input/Button pad Y", "inputBtnPaddingYRem", "number", "0.375", "$input-btn-padding-y (rem).", min: "0", max: "1.5", step: "0.025")
                                @RenderSettingRow("Input/Button pad X", "inputBtnPaddingXRem", "number", "0.75", "$input-btn-padding-x (rem).", min: "0", max: "2", step: "0.025")
                                @RenderSettingRow("Button pad Y", "btnPaddingYRem", "number", "0.375", "$btn-padding-y (rem).", min: "0", max: "1.5", step: "0.025")
                                @RenderSettingRow("Button pad X", "btnPaddingXRem", "number", "0.75", "$btn-padding-x (rem).", min: "0", max: "2", step: "0.025")
                                @RenderSettingRow("Button radius", "btnBorderRadiusPx", "number", "6", "$btn-border-radius (px).", min: "0", max: "40", step: "1")
                                @RenderSettingRow("Select indicator color", "formSelectIndicatorColor", "color", "#6c757d", "$form-select-indicator-color.")
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <section class="card dmb-preview-advanced">
                            <div class="card-body d-grid gap-3">
                                <h3 class="h6 mb-0">Preview - Forms & Buttons</h3>
                                <div class="d-grid gap-2">
                                    <input class="form-control dmb-preview-input" value="Input sample" />
                                    <select class="form-select dmb-preview-select">
                                        <option>Option 1</option>
                                        <option>Option 2</option>
                                    </select>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            }

            @using (Html.TabBlockBuilder().WithTitle("Cards").WithIcon(IconStruct.Bootstrap("bi-postcard")).Begin())
            {
                <div class="row g-4">
                    <div class="col-12 col-lg-6 d-grid gap-3">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0 dmb-setting-table">
                                <colgroup>
                                    <col class="dmb-col-label" />
                                    <col class="dmb-col-mode" />
                                    <col class="dmb-col-field" />
                                    <col class="dmb-col-value" />
                                    <col class="dmb-col-reset" />
                                    <col class="dmb-col-info" />
                                </colgroup>
                                <tbody>
                                @RenderSettingRow("Card bg", "cardBg", "color", "#ffffff", "$card-bg.")
                                @RenderSettingRow("Card border color", "cardBorderColor", "color", "#dee2e6", "$card-border-color (used when mode=custom).")
                                @RenderSettingRow("Card border width", "cardBorderWidthPx", "number", "1", "$card-border-width in px (used when mode=custom).", min: "0", max: "10", step: "1")
                                @RenderSettingRow("Card border radius", "cardBorderRadiusPx", "number", "8", "$card-border-radius in px (used when mode=custom).", min: "0", max: "48", step: "1")
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <section class="card dmb-preview-advanced">
                            <div class="card-body d-grid gap-3">
                                <h3 class="h6 mb-0">Preview - Cards</h3>
                                <div class="card dmb-preview-card">
                                    <div class="card-header">Card header</div>
                                    <div class="card-body">
                                        <h5 class="card-title mb-2">Card title</h5>
                                        <p class="card-text mb-3">This card reflects card background and border settings.</p>
                                        <a class="btn btn-primary btn-sm" href="#">Card action</a>
                                    </div>
                                    <div class="card-footer text-muted">Card footer</div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            }

            @using (Html.TabBlockBuilder().WithTitle("Components").WithIcon(IconStruct.Bootstrap("bi-window-stack")).Begin())
            {
                <div class="row g-4">
                    <div class="col-12 col-lg-6 d-grid gap-3">
                        <div class="table-responsive">
