            (config.cardBorderWidthPxMode === "custom" ? "$card-border-width: " + config.cardBorderWidthPx + "px;" : "// $card-border-width inherits from $border-width"),
            (config.cardBorderRadiusPxMode === "custom"
                ? "$card-border-radius: " + pxToRem(config.cardBorderRadiusPx) + ";"
                : (config.cardBorderRadiusPxMode === "formula"
                    ? "$card-border-radius: subtract($border-radius, $card-border-width);"
                    : "// $card-border-radius inherits from $border-radius")),
