<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <RootNamespace>DMBBootstrapLiveConfigurator</RootNamespace>
    <Title>DMBBootstrapLiveConfigurator</Title>
    <PackageTags>idemobi DMB PageBuilder Bootstrap Theme Configurator Preview Razor MVC</PackageTags>
    <Description>Live Bootstrap theme configurator with embedded preview pages, scripts, and static assets.</Description>
    <PackageReleaseNotes>note</PackageReleaseNotes>
    <PackageIcon>DMBBootstrapLiveConfigurator.png</PackageIcon>
    <AssemblyOriginatorKeyFile>DMBBootstrapLiveConfigurator.snk</AssemblyOriginatorKeyFile>
    <PackageId>DMBBootstrapLiveConfigurator</PackageId>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultRazorGenerateItems>true</EnableDefaultRazorGenerateItems>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <IncludeRazorContentInPack>false</IncludeRazorContentInPack>
    <EmbedRazorGenerateSources>false</EmbedRazorGenerateSources>
    <LangVersion>default</LangVersion>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <RunAnalyzers>true</RunAnalyzers>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <Configurations>Debug;Release;NuGet</Configurations>
    <Platforms>AnyCPU</Platforms>
    <Version>0.21.0</Version>
    <FileVersion>0.21.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Company>idéMobi</Company>
    <Authors>Jean-François CONTART, Quentin BOULOGNE, Camille GOLLIOT</Authors>
    <Copyright>Copyright © $(Company) $([System.DateTime]::UtcNow.ToString("yyyy"))</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageProjectUrl>https://dev.azure.com/ideMobi/DMBBootstrapBuilder/_git/DMBBootstrapBuilder</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>git@ssh.dev.azure.com:v3/ideMobi/DMBBootstrapBuilder/DMBBootstrapBuilder</RepositoryUrl>
    <RepositoryType>AzureDevOps</RepositoryType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyMetadataAttribute>true</GenerateAssemblyMetadataAttribute>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DocumentationFile>bin\Release\net10.0\DMBBootstrapLiveConfigurator.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DocumentationFile>bin\Debug\net10.0\DMBBootstrapLiveConfigurator.xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'NuGet' ">
    <DefineConstants>NUGET</DefineConstants>
    <Optimize>true</Optimize>
    <DocumentationFile>bin\NuGet\net10.0\DMBBootstrapLiveConfigurator.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <Choose>
    <When Condition=" '$(Configuration)' == 'NuGet' ">
      <ItemGroup Label="Case NuGet">
        <PackageReference Include="DMBPageBuilder" Version="0.21.0" />
        <PackageReference Include="DMBBootstrapBuilder" Version="0.21.0" />
        <PackageReference Include="DMBServerWebHelper" Version="0.21.0" />
        <PackageReference Include="DMBServerHelper" Version="0.21.0" />
        <PackageReference Include="DMBComponentBuilder" Version="0.21.0" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup Label="Case Debug, Release, Deployment">
        <ProjectReference Include="..\..\DMBPageBuilder\Source\DMBPageBuilder.csproj" />
        <ProjectReference Include="..\Source\DMBBootstrapBuilder.csproj" />
        <ProjectReference Include="..\..\DMBServerWebHelper\Source\DMBServerWebHelper.csproj" />
        <ProjectReference Include="..\..\DMBServerHelper\Source\DMBServerHelper.csproj" />
        <ProjectReference Include="..\..\DMBComponentBuilder\Source\DMBComponentBuilder.csproj" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <ItemGroup Label="Import package">
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup Label="Files in package">
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="DMBBootstrapLiveConfigurator.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Label="EmbeddedResource">
    <Content Remove="wwwroot\**\*" />
    <EmbeddedResource Include="wwwroot\**\*" />
    <EmbeddedResource Include="Views\**\*.cshtml" />
  </ItemGroup>
    <ItemGroup Label="Project file exclusions">
        <None Remove=".gitignore" />
    </ItemGroup>
</Project>
