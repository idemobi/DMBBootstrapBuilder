<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <RootNamespace>DMBBootstrapBuilder</RootNamespace>
        <Title>DMBBootstrapBuilder</Title>
        <PackageTags>idemobi DMB PageBuilder Bootstrap UI Components Layout Razor MVC</PackageTags>
        <Description>Bootstrap-oriented UI builder package for PageBuilder MVC/Razor applications.</Description>
        <PackageReleaseNotes>note</PackageReleaseNotes>
        <PackageIcon>DMBBootstrapBuilder.png</PackageIcon>
        <AssemblyOriginatorKeyFile>DMBBootstrapBuilder.snk</AssemblyOriginatorKeyFile>
        <PackageId>DMBBootstrapBuilder</PackageId>
    </PropertyGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultRazorGenerateItems>true</EnableDefaultRazorGenerateItems>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <IncludeRazorContentInPack>false</IncludeRazorContentInPack>
        <EmbedRazorGenerateSources>false</EmbedRazorGenerateSources>
        <LangVersion>default</LangVersion>
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
        <RunAnalyzers>true</RunAnalyzers>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <SignAssembly>true</SignAssembly>
        <PublicSign>true</PublicSign>
        <Configurations>Debug;Release;NuGet</Configurations>
        <Platforms>AnyCPU</Platforms>
        <VersionBase>$([System.DateTime]::UtcNow.ToString("yyyy.Mdd.HHmm"))</VersionBase>
        
        <BuildDate>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss"))</BuildDate>
        <Version>0.13.3</Version>
        <FileVersion>0.13.3.0</FileVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <Company>idéMobi</Company>
        <Authors>Jean-François CONTART, Quentin BOULOGNE, Camille GOLLIOT</Authors>
        <Copyright>Copyright © $(Company) $([System.DateTime]::UtcNow.ToString("yyyy"))</Copyright>
        <NeutralLanguage>en</NeutralLanguage>
        <PackageProjectUrl>https://dev.azure.com/ideMobi/DMBBootstrapBuilder/_git/DMBBootstrapBuilder</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>git@ssh.dev.azure.com:v3/ideMobi/DMBBootstrapBuilder/DMBBootstrapBuilder</RepositoryUrl>
        <RepositoryType>AzureDevOps</RepositoryType>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <GenerateAssemblyMetadataAttribute>true</GenerateAssemblyMetadataAttribute>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <DefineConstants />
        <DocumentationFile>bin\Release\net10.0\DMBBootstrapBuilder.xml</DocumentationFile>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <DocumentationFile>bin\Debug\net10.0\DMBBootstrapBuilder.xml</DocumentationFile>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'NuGet' ">
        <DefineConstants>NUGET</DefineConstants>
        <Optimize>true</Optimize>
        <DocumentationFile>bin\NuGet\net10.0\DMBBootstrapBuilder.xml</DocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <Choose>
        <When Condition=" '$(Configuration)' == 'NuGet' ">
            <ItemGroup Label="Case NuGet">
                <PackageReference Include="DMBPageBuilder" Version="0.13.3" />
                <PackageReference Include="DMBServerWebHelper" Version="0.13.3" />
                <PackageReference Include="DMBServerHelper" Version="0.13.3" />
            </ItemGroup>
        </When>
        <Otherwise>
            <ItemGroup Label="Case Debug, Release, Deployment">
                <ProjectReference Include="..\..\DMBPageBuilder\Source\DMBPageBuilder.csproj" />
                <ProjectReference Include="..\..\DMBServerWebHelper\Source\DMBServerWebHelper.csproj" />
                <ProjectReference Include="..\..\DMBServerHelper\Source\DMBServerHelper.csproj" />
            </ItemGroup>
        </Otherwise>
    </Choose>
    <ItemGroup Label="Import package">
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.8" />
        <PackageReference Include="SkiaSharp" Version="3.119.4" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" />
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
        <PackageReference Include="ChartJSCore" Version="3.12.0" />
    </ItemGroup>
    <ItemGroup Label="Files in package">
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="LICENSE.md" Pack="true" PackagePath="\" />
        <None Include="DMBBootstrapBuilder.png" Pack="true" PackagePath="\" />
        <None Remove="**/*.meta" />
        <Compile Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.Designer.cs">
          <DesignTime>True</DesignTime>
          <AutoGen>True</AutoGen>
          <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\DMBBootstrapBuilderInternalLocalization.Designer.cs">
          <DesignTime>True</DesignTime>
          <AutoGen>True</AutoGen>
          <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </Compile>
        <None Update="NuGetMe.sh">
          <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup Condition=" '$(Configuration)' == 'Debug' " Label="Razor Generator">
        <Content Update="Views\*">
            <Generator>RazorGenerator</Generator>
        </Content>
    </ItemGroup>
    <ItemGroup Label="EmbeddedResource">
        <Content Remove="wwwroot\**\*" />
        <EmbeddedResource Include="wwwroot\**\*" />
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.en-US.resx">
            <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.fr-FR.resx">
            <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.en-US.resx">
            <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.fr-FR.resx">
            <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>DMBBootstrapBuilderInternalLocalization.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>DMBBootstrapBuilderDataAnnotationLocalization.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.resx">
          <Generator>ResXFileCodeGenerator</Generator>
          <LastGenOutput>DMBBootstrapBuilderDataAnnotationLocalization.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.resx">
          <Generator>ResXFileCodeGenerator</Generator>
          <LastGenOutput>DMBBootstrapBuilderInternalLocalization.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.de-DE.resx">
          <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.es-ES.resx">
          <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.it-IT.resx">
          <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.ja-JP.resx">
          <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.ko-KR.resx">
          <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.nl-NL.resx">
          <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.pt-BR.resx">
          <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.tlh.resx">
          <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.zh-CN.resx">
          <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.de-DE.resx">
          <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.es-ES.resx">
          <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.it-IT.resx">
          <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.ja-JP.resx">
          <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.ko-KR.resx">
          <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.nl-NL.resx">
          <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.pt-BR.resx">
          <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.tlh.resx">
          <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.zh-CN.resx">
          <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup Label="Localization">
        <Compile Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>DMBBootstrapBuilderDataAnnotationLocalization.resx</DependentUpon>
        </Compile>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderDataAnnotationLocalization.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>DMBBootstrapBuilderDataAnnotationLocalization.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <Compile Update="Resources\DMBBootstrapBuilderInternalLocalization.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>DMBBootstrapBuilderInternalLocalization.resx</DependentUpon>
        </Compile>
        <EmbeddedResource Update="Resources\DMBBootstrapBuilderInternalLocalization.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>DMBBootstrapBuilderInternalLocalization.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="NuGetMe.sh" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Components\Base\Bootstrap\CustomClasses\" />
    </ItemGroup>
    <ItemGroup>
      <_ContentIncludedByDefault Remove="wwwroot\css\effects\SectionInnerTitleEffects.css" />
      <_ContentIncludedByDefault Remove="wwwroot\css\effects\SectionRenderEffect.css" />
      <_ContentIncludedByDefault Remove="wwwroot\css\effects\VideoSection.css" />
    </ItemGroup>
    <ItemGroup Label="Project file exclusions">
        <None Remove=".gitignore" />
    </ItemGroup>
</Project>
