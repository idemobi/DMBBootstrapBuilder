@{
    Layout = "_Layout";
}

@using (Html.SectionBuilder().SetHeight(125, UnitSize.px).BootstrapBackgroundEffect(VariantStyle.Normal).Begin())
{
    @using (Html.FlexBlockBuilder().SetAlignItemsCenter().SetJustifyContentCenter().Begin())
    {
        @using (Html.BlockBuilder().AsTextCenter().Begin())
        {
            @Html.TitleBuilder().SetTitle("Sidebar", TitleLevel.One).Render()
            @using (Html.PB_P().AsMuted().Begin())
            {
                @:A collapsible navigation panel with sections and nested link groups.
            }
        }
    }
}

@* ── SideBarComponent ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("SideBarComponent", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:Instantiate SideBarComponent, call AddSection(title, items) one or more times, then call Render(Html) to output the sidebar HTML.
        }
    }
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/SideBar/_SideBarBasic", "SideBarComponent", IconStruct.Bootstrap("bi-layout-sidebar"))
}

@* ── Multiple Sections ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Multiple Sections", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:Each AddSection() call creates a labelled group. Pass null as the title for an untitled section.
        }
    }
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/SideBar/_SideBarMultipleSections", "Multiple sections", IconStruct.Bootstrap("bi-list-nested"))
}
