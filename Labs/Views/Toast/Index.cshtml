@{
    Layout = "_Layout";
    string DocUrl(string c) => $"/Documentation/Show?packageId=DMBBootstrapBuilder&groupName=NuGet&namespaceName=DMBBootstrapBuilder&objectName={c}";
}

@using (Html.SectionBuilder().SetHeight(125, UnitSize.px).BootstrapBackgroundEffect(VariantStyle.Normal).Begin())
{
    @using (Html.FlexBlockBuilder().SetAlignItemsCenter().SetJustifyContentCenter().Begin())
    {
        @using (Html.BlockBuilder().AsTextCenter().Begin())
        {
            @Html.TitleBuilder().SetTitle("Toast", TitleLevel.One).Render()
            @using (Html.PB_P().AsMuted().Begin())
            {
                @:Short-lived notification messages — variants, subtitle, icon, auto-hide and custom body content.
            }
        }
    }
}

@* ── Basic ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Basic", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:Html.Toast() renders a Bootstrap toast. SetTitle and SetMessage provide the header and body text.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ToastBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Toast/_ToastBasic", "Basic toast", IconStruct.Bootstrap("bi-chat-square-text"))
}

@* ── Variants ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Variants", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetVariant(VariantStyle) colours the toast header — the same set available on alerts and modals.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ToastBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @using (Html.BlockBuilder().AsExamplePreview().Begin())
    {
        @await Html.PartialAsync("~/Views/Shared/Examples/Toast/_ToastVariants.cshtml")
    }
    @await Html.RenderExamplePartialAsync("Examples/Toast/_ToastVariantsFocused", "Variants", IconStruct.Bootstrap("bi-palette"))
}

@* ── Subtitle & Icon ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Subtitle & Icon", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetSubtitle(string) adds a small timestamp or context label. SetIcon(IconStruct) places an icon in the header.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ToastBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Toast/_ToastSubtitleIcon", "Subtitle & icon", IconStruct.Bootstrap("bi-clock"))
}

@* ── Auto-hide ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Auto-hide", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetAutoHide(false) keeps the toast visible until the user closes it — useful when a decision is required.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ToastBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Toast/_ToastAutoHide", "Auto-hide", IconStruct.Bootstrap("bi-hourglass-split"))
}

@* ── Custom body ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Custom body", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:.Begin() switches to wrapping mode — any HTML or builder content placed inside replaces the default message body.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ToastBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Toast/_ToastCustomBody", "Custom body", IconStruct.Bootstrap("bi-braces"))
}
