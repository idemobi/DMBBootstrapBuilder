<div class="dmb-demo-code border rounded-3 overflow-hidden bg-body"><div class="dmb-demo-code-header px-3 py-2 border-bottom bg-body-tertiary d-flex align-items-center"><span class="badge text-bg-secondary font-monospace">C#</span></div><pre class="language-csharp mb-0 border-0 rounded-0"><code class="language-csharp">@@using DMBBootstrapBuilder
@@using DMBPageBuilder
@@{ _ = new RTLToggleActionItem(Html, true); }
@@using (Html.FlexBlockBuilder().WithGap(Old_Gap.Gap2).Begin())
{
    @@Html.Button(new JavaScriptActionItem("RTLModeMethod.set(true); return false;")
        .SetTitle("Enable RTL")
        .SetIcon(IconStruct.Bootstrap("bi-text-right"))
        .SetVariant(VariantStyle.Secondary)
        .SetOutlined())
    @@Html.Button(new JavaScriptActionItem("RTLModeMethod.set(false); return false;")
        .SetTitle("Disable RTL")
        .SetIcon(IconStruct.Bootstrap("bi-text-left"))
        .SetVariant(VariantStyle.Secondary)
        .SetOutlined())
}</code></pre></div>