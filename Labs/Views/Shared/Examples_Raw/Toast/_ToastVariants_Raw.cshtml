<div class="dmb-demo-code border rounded-3 overflow-hidden bg-body"><div class="dmb-demo-code-header px-3 py-2 border-bottom bg-body-tertiary d-flex align-items-center"><span class="badge text-bg-secondary font-monospace">C#</span></div><pre class="language-csharp mb-0 border-0 rounded-0"><code class="language-csharp">@@using DMBBootstrapBuilder
@@using DMBPageBuilder
@@using (Html.BlockBuilder().AddClass("toast-container position-static d-flex flex-column gap-2").Begin())
{
    @@(Html.Toast().SetTitle("Published").SetMessage("Page is now live.").SetVariant(VariantStyle.Primary).Render())
    @@(Html.Toast().SetTitle("Saved").SetMessage("All changes persisted.").SetVariant(VariantStyle.Success).Render())
    @@(Html.Toast().SetTitle("Low storage").SetMessage("Less than 10 % remaining.").SetVariant(VariantStyle.Warning).Render())
    @@(Html.Toast().SetTitle("Error").SetMessage("Upload failed — please retry.").SetVariant(VariantStyle.Danger).Render())
    @@(Html.Toast().SetTitle("Info").SetMessage("Scheduled maintenance on Sunday.").SetVariant(VariantStyle.Info).Render())
}</code></pre></div>