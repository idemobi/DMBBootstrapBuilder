<div class="dmb-demo-code border rounded-3 overflow-hidden bg-body"><div class="dmb-demo-code-header px-3 py-2 border-bottom bg-body-tertiary d-flex align-items-center"><span class="badge text-bg-secondary font-monospace">C#</span></div><pre class="language-csharp mb-0 border-0 rounded-0"><code class="language-csharp">@@using DMBBootstrapBuilder
@@using DMBPageBuilder
@@(Html.AlertBuilder()
    .SetTitle("Updates available")
    .SetMessage("A new version of the package is ready to install.")
    .SetVariant(VariantStyle.Info)
    .SetIcon(IconStruct.Bootstrap("bi-arrow-repeat"))
    .SetDismissible()
    .Render())
@@(Html.AlertBuilder()
    .SetTitle("Draft saved")
    .SetMessage("Your changes have been saved automatically.")
    .SetVariant(VariantStyle.Success)
    .SetIcon(IconStruct.Bootstrap("bi-floppy"))
    .SetDismissible(animated: true)
    .Render())</code></pre></div>