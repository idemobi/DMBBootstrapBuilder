<div class="dmb-demo-code border rounded-3 overflow-hidden bg-body"><div class="dmb-demo-code-header px-3 py-2 border-bottom bg-body-tertiary d-flex align-items-center"><span class="badge text-bg-secondary font-monospace">C#</span></div><pre class="language-csharp mb-0 border-0 rounded-0"><code class="language-csharp">@@using DMBBootstrapBuilder
@@using DMBPageBuilder
@@(Html.AlertBuilder()
    .SetTitle("Confirm deletion")
    .SetMessage("This will permanently remove the selected records.")
    .SetVariant(VariantStyle.Warning)
    .SetIcon(IconStruct.Bootstrap("bi-trash"))
    .AddFooterAction(ActionItemFactory.Url("Delete", "#", IconStruct.Bootstrap("bi-trash")).SetVariant(VariantStyle.Danger))
    .Render())
@@(Html.AlertBuilder()
    .SetTitle("Review required")
    .SetMessage("Changes are pending approval before publication.")
    .SetVariant(VariantStyle.Primary)
    .SetIcon(IconStruct.Bootstrap("bi-eye"))
    .AddFooterAction(ActionItemFactory.Url("Review", "#", IconStruct.Bootstrap("bi-search")).SetVariant(VariantStyle.Primary))
    .AddFooterAction(ActionItemFactory.Url("Dismiss", "#").SetVariant(VariantStyle.Secondary).SetOutlined())
    .Render())</code></pre></div>