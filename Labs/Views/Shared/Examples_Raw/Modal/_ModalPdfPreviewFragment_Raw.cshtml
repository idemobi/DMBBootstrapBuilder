<div class="dmb-demo-code border rounded-3 overflow-hidden bg-body"><div class="dmb-demo-code-header px-3 py-2 border-bottom bg-body-tertiary d-flex align-items-center"><span class="badge text-bg-secondary font-monospace">C#</span></div><pre class="language-csharp mb-0 border-0 rounded-0"><code class="language-csharp">@@{
    string pdfUrl = Url.Action("SamplePdf", "Modal") ?? "/Modal/SamplePdf";
}

@@using (Html.ModalBuilder()
            .Id("ex-modal-pdf-preview")
            .WithTitle("PDF Preview", TitleLevel.Three, IconStruct.Bootstrap("bi-file-earmark-pdf"))
            .WithVariant(VariantStyle.Danger)
            .Size(ModalSize.Xl)
            .AddPDFPreviewURL(pdfUrl, 640)
            .Trigger("Open PDF", IconStruct.Bootstrap("bi-box-arrow-up-right"))
            .TriggerStyle(VariantStyle.Primary)
            .RenderTriggerInsideBegin()
            .Begin())
{
}</code></pre></div>
