<div class="dmb-demo-code border rounded-3 overflow-hidden bg-body"><div class="dmb-demo-code-header px-3 py-2 border-bottom bg-body-tertiary d-flex align-items-center"><span class="badge text-bg-secondary font-monospace">C#</span></div><pre class="language-csharp mb-0 border-0 rounded-0"><code class="language-csharp">@@using DMBBootstrapBuilder
@@using DMBPageBuilder
@@using (Html.RowBuilder().Begin())
{
    @@using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
    {
        @@using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @@Html.TitleBuilder().SetTitle("Border · Primary", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @@Html.LoadingBlock().Border().Style(VariantStyle.Primary).Text("Loading…").MinHeightPx(100).WithClasses("border rounded")
    }
    @@using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
    {
        @@using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @@Html.TitleBuilder().SetTitle("Grow · Danger", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @@Html.LoadingBlock().Grow().Style(VariantStyle.Danger).Text("Deleting…").SpinnerSizePx(36).MinHeightPx(100).WithClasses("border rounded")
    }
    @@using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
    {
        @@using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @@Html.TitleBuilder().SetTitle("Small spinner · Secondary", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @@Html.LoadingBlock().Border().Style(VariantStyle.Secondary).SmallSpinner().Text("Refreshing…").MinHeightPx(100).WithClasses("border rounded")
    }
    @@using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
    {
        @@using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @@Html.TitleBuilder().SetTitle("No text · Grow · Success", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @@Html.LoadingBlock().Grow().Style(VariantStyle.Success).Text(null).SpinnerSizePx(42).MinHeightPx(100).WithClasses("border rounded")
    }
}</code></pre></div>