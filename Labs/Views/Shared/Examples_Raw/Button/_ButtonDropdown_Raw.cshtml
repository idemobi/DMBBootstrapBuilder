<div class="dmb-demo-code border rounded-3 overflow-hidden bg-body"><div class="dmb-demo-code-header px-3 py-2 border-bottom bg-body-tertiary d-flex align-items-center"><span class="badge text-bg-secondary font-monospace">C#</span></div><pre class="language-csharp mb-0 border-0 rounded-0"><code class="language-csharp">@@using DMBBootstrapBuilder
@@using DMBPageBuilder
@@{
    var dropdown = ActionItemFactory.Group("Actions", IconStruct.Bootstrap("bi-list"))
        .AddItems(
            ActionItemFactory.Url("Open docs", "#", IconStruct.Bootstrap("bi-book")),
            ActionItemFactory.JavaScript("Log to console", "console.log('hello')", IconStruct.Bootstrap("bi-terminal")),
            ActionItemFactory.ClipboardButton("Copy token", "Copy", "Copied"),
            ActionItemFactory.Divider()
        );
    var subGroup = ActionItemFactory.Group("More", IconStruct.Bootstrap("bi-folder"));
    subGroup.AddItems(
        ActionItemFactory.Url("Settings", "#", IconStruct.Bootstrap("bi-gear")),
        ActionItemFactory.Url("Danger zone", "#", IconStruct.Bootstrap("bi-exclamation-triangle")).SetVariant(VariantStyle.Danger)
    );
    dropdown.AddItem(subGroup);
}

@@using (Html.FlexBlockBuilder().WithGap(Old_Gap.Gap2).Begin())
{
    @@Html.Button(dropdown.SetVariant(VariantStyle.Primary)).Render()
    @@Html.Button(ActionItemFactory.Group("Outlined", IconStruct.Bootstrap("bi-list")).SetVariant(VariantStyle.Secondary).SetOutlined()
        .AddItems(
            ActionItemFactory.Url("Item A", "#"),
            ActionItemFactory.Url("Item B", "#")
        )).Render()
}</code></pre></div>