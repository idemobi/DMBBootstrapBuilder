@(Html.AlertBuilder()
    .SetTitle("Updates available")
    .SetMessage("A new version of the package is ready to install.")
    .SetVariant(VariantStyle.Info)
    .SetIcon(IconStruct.Bootstrap("bi-arrow-repeat"))
    .SetDismissible()
    .Render())
@(Html.AlertBuilder()
    .SetTitle("Draft saved")
    .SetMessage("Your changes have been saved automatically.")
    .SetVariant(VariantStyle.Success)
    .SetIcon(IconStruct.Bootstrap("bi-floppy"))
    .SetDismissible(animated: true)
    .Render())
