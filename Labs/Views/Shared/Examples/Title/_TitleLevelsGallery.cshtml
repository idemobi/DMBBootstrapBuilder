    {
        @Html.TitleBuilder().SetTitle("Heading Four", TitleLevel.Four).Render()
        @Html.TitleBuilder().SetTitle("Heading Five", TitleLevel.Five).Render()
        @Html.TitleBuilder().SetTitle("Heading Six", TitleLevel.Six).Render()
    }
}
