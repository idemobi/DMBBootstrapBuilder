@using (Html.FlexBlockBuilder().SetAlignItemsCenter().Begin())
{
    @Html.TitleBuilder().SetTitle("Primary", TitleLevel.Five).SetTextVariant(VariantStyle.Primary).Render()
    @Html.TitleBuilder().SetTitle("Secondary", TitleLevel.Five).SetTextVariant(VariantStyle.Secondary).Render()
    @Html.TitleBuilder().SetTitle("Success", TitleLevel.Five).SetTextVariant(VariantStyle.Success).Render()
    @Html.TitleBuilder().SetTitle("Danger", TitleLevel.Five).SetTextVariant(VariantStyle.Danger).Render()
    @Html.TitleBuilder().SetTitle("Warning", TitleLevel.Five).SetTextVariant(VariantStyle.Warning).Render()
    @Html.TitleBuilder().SetTitle("Info", TitleLevel.Five).SetTextVariant(VariantStyle.Info).Render()
    @Html.TitleBuilder().SetTitle("Light", TitleLevel.Five).SetTextVariant(VariantStyle.Light).Render()
    @Html.TitleBuilder().SetTitle("Dark", TitleLevel.Five).SetTextVariant(VariantStyle.Dark).Render()
}
