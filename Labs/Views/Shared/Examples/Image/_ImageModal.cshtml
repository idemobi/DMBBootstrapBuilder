@using (Html.RowBuilder().Begin())
{
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col4, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("OpenInModal()", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ImageRender("/images/test/test1.png").Alt("Modal PNG").SetWidth(320, UnitSize.px).SetHeight(220, UnitSize.px).OpenInModal().SetRounded()
    }
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col4, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("OpenInModal() + AllowDownload()", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ImageRender("/images/test/test2.png").Alt("Modal download").SetWidth(320, UnitSize.px).SetHeight(220, UnitSize.px).OpenInModal().AllowDownload().SetBorder().SetRounded()
    }
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col4, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("SVG · AllowThemeDownload()", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ImageRender("/images/test/PlayerData.svg").Alt("SVG modal themed").InlineSvg().SetWidth(320, UnitSize.px).SetHeight(220, UnitSize.px).OpenInModal().AllowDownload().AllowThemeDownload().SetBorder()
    }
}
