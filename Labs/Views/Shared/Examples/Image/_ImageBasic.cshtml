@using (Html.RowBuilder().Begin())
{
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col4, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("PNG · fixed size", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ImageRender("/images/test/test1.png").Alt("PNG simple").SetWidth(320, UnitSize.px).SetHeight(220, UnitSize.px).SetBorder()
    }
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col4, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("PNG · rounded + border", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ImageRender("/images/test/test2.png").Alt("PNG rounded").SetWidth(320, UnitSize.px).SetHeight(220, UnitSize.px).SetBorder().SetRounded()
    }
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col4, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("SVG inline", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ImageRender("/images/test/PlayerData.svg").Alt("SVG inline").InlineSvg().SetWidth(320, UnitSize.px).SetHeight(220, UnitSize.px).SetBorder()
    }
}
