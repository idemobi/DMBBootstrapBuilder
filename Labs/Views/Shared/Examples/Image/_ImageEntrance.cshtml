@using (Html.RowBuilder().Begin())
{
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col4, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("PolaroidEffect()", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ImageRender("/images/test/test1.png").Alt("Polaroid").SetWidth(260, UnitSize.px).SetHeight(180, UnitSize.px).PolaroidEffect()
    }
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col4, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("GrayscaleToColorEffect()", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ImageRender("/images/test/test1.png").Alt("Grayscale to color").SetWidth(260, UnitSize.px).SetHeight(180, UnitSize.px).SetBorder().GrayscaleToColorEffect()
    }
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col4, ResponsiveBreakpoint.Md).Begin())
    {
