    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col4, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("NeonFrameEffect()", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ImageRender("/images/test/test1.png").Alt("Neon").SetWidth(260, UnitSize.px).SetHeight(180, UnitSize.px).SetBorder().NeonFrameEffect()
