@using (Html.TabAreaBuilder().Underline().WithContentClasses("pt-3").Begin())
{
    @using (Html.TabBlockBuilder().WithTitle("Inbox").WithSubtitle("Unread").WithIcon(IconStruct.Bootstrap("bi-inbox")).AddBadge("12", VariantStyle.Danger).Active().Begin())
    {
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:12 unread messages waiting for your attention.
        }
    }
    @using (Html.TabBlockBuilder().WithTitle("Tasks").WithSubtitle("In progress").WithIcon(IconStruct.Bootstrap("bi-list-check")).AddBadge("4", VariantStyle.Warning).Begin())
    {
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:4 pending tasks assigned to you.
        }
    }
    @using (Html.TabBlockBuilder().WithTitle("Done").WithSubtitle("Completed").WithIcon(IconStruct.Bootstrap("bi-check-circle")).AddBadge("28", VariantStyle.Success).Begin())
    {
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:28 items completed this month.
        }
    }
}
