@using (Html.RowBuilder().Begin())
{
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("Primary · 60%", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ProgressBar().SetValue(60).SetVariant(VariantStyle.Primary)
    }
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("Success · 80%", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ProgressBar().SetValue(80).SetVariant(VariantStyle.Success)
    }
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("Warning · 45%", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ProgressBar().SetValue(45).SetVariant(VariantStyle.Warning)
    }
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("Danger · 25%", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ProgressBar().SetValue(25).SetVariant(VariantStyle.Danger)
    }
}
