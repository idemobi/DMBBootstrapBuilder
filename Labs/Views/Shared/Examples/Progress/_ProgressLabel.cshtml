@using (Html.RowBuilder().Begin())
{
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("SetShowLabel()", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ProgressBar().SetValue(65).SetVariant(VariantStyle.Info).SetShowLabel()
    }
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("SetLabel(\"120 / 250\")", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ProgressBar().SetMin(0).SetMax(250).SetValue(120).SetVariant(VariantStyle.Warning).SetLabel("120 / 250").SetShowLabel()
    }
}
