@using (Html.RowBuilder().Begin())
{
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("Striped", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ProgressBar().SetValue(55).SetVariant(VariantStyle.Primary).SetStriped()
    }
    @using (Html.ColBuilder().SetCol(ColSize.Col12).SetCol(ColSize.Col6, ResponsiveBreakpoint.Md).Begin())
    {
        @using (Html.BlockBuilder().AsSectionSubLabel().Begin())
        {
            @Html.TitleBuilder().SetTitle("Striped + Animated", TitleLevel.Six).AsSubSectionTitle().Render()
        }
        @Html.ProgressBar().SetValue(70).SetVariant(VariantStyle.Success).SetStriped().SetAnimated()
    }
}
