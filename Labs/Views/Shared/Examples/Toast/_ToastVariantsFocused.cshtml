@using (Html.BlockBuilder().AddClass("toast-container position-static d-flex flex-column gap-2").Begin())
{
    @(Html.Toast().SetTitle("Saved").SetMessage("All changes persisted.").SetVariant(VariantStyle.Success).Render())
    @(Html.Toast().SetTitle("Error").SetMessage("Upload failed — please retry.").SetVariant(VariantStyle.Danger).Render())
}
