@using (Html.BlockBuilder().AddClass("toast-container position-static d-flex flex-column gap-2").Begin())
{
    @(Html.Toast().SetTitle("New comment").SetSubtitle("2 min ago").SetMessage("Alice replied to your post.").SetVariant(VariantStyle.Primary).Render())
    @(Html.Toast().SetTitle("Deployment finished").SetSubtitle("just now").SetMessage("Version 2.4.1 is live on production.").SetVariant(VariantStyle.Success).SetIcon(IconStruct.Bootstrap("bi-cloud-check")).Render())
}
