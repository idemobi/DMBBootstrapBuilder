@{
    Layout = "_Layout";
}

@using (Html.SectionBuilder().SetHeight(125, UnitSize.px).BootstrapBackgroundEffect(VariantStyle.Normal).Begin())
{
    @using (Html.FlexBlockBuilder().SetAlignItemsCenter().SetJustifyContentCenter().Begin())
    {
        @using (Html.BlockBuilder().AsTextCenter().Begin())
        {
            @Html.TitleBuilder().SetTitle("Theme Mode", TitleLevel.One).Render()
            @using (Html.PB_P().AsMuted().Begin())
            {
                @:Switch the page between light, dark, and automatic (system) themes.
            }
        }
    }
}

@* ── ThemeModeActionItem ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("ThemeModeActionItem", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:Each button applies a theme immediately. The choice is persisted across pages via a cookie.
        }
    }
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Theme/_ThemeModeButtons", "Theme mode", IconStruct.Bootstrap("bi-circle-half"))
}
