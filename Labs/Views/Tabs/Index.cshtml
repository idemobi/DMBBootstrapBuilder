@{
    Layout = "_Layout";
    string DocUrl(string c) => $"/Documentation/Show?packageId=DMBBootstrapBuilder&groupName=NuGet&namespaceName=DMBBootstrapBuilder&objectName={c}";
}

@using (Html.SectionBuilder().SetHeight(125, UnitSize.px).BootstrapBackgroundEffect(VariantStyle.Normal).Begin())
{
    @using (Html.FlexBlockBuilder().SetAlignItemsCenter().SetJustifyContentCenter().Begin())
    {
        @using (Html.BlockBuilder().AsTextCenter().Begin())
        {
            @Html.TitleBuilder().SetTitle("Tabs", TitleLevel.One).Render()
            @using (Html.PB_P().AsMuted().Begin())
            {
                @:Switchable content panels — tabs, pills or underline style, with icons, badges, subtitles and hash navigation.
            }
        }
    }
}

@* ── Tabs ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Tabs", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:TabAreaBuilder.Tabs() renders the classic Bootstrap tab navigation. Active() sets the initially selected panel; Disabled() prevents a tab from being clicked.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(TabAreaBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Tabs/_TabsTabs", "Tabs", IconStruct.Bootstrap("bi-folder"))
}

