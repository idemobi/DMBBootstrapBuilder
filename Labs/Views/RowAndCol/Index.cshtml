@{
    Layout = "_Layout";
}

@using (Html.SectionBuilder().SetHeight(125, UnitSize.px).BootstrapBackgroundEffect(VariantStyle.Normal).Begin())
{
    @using (Html.FlexBlockBuilder().SetAlignItemsCenter().SetJustifyContentCenter().Begin())
    {
        @using (Html.BlockBuilder().AsTextCenter().Begin())
        {
            @Html.TitleBuilder().SetTitle("Row & Col", TitleLevel.One).Render()
            @using (Html.PB_P().AsMuted().Begin())
            {
                @:Build responsive grid layouts using RowBuilder and ColBuilder.
            }
        }
    }
}

@* ── Equal Columns ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Equal Columns", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:ColSize.Col shares available space equally across all columns.
        }
    }
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/RowAndCol/_RowColEqual", "Equal columns", IconStruct.Bootstrap("bi-layout-three-columns"))
}

@* ── Fixed Widths ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Fixed Widths", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetCol(ColSize.ColN) assigns a precise width out of 12 grid columns.
        }
    }
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/RowAndCol/_RowColFixed", "Fixed widths", IconStruct.Bootstrap("bi-layout-split"))
}

@* ── Responsive Breakpoints ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Responsive Breakpoints", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:Pass a ResponsiveBreakpoint to SetCol() to apply a different width at each viewport size.
        }
    }
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/RowAndCol/_RowColResponsive", "Responsive", IconStruct.Bootstrap("bi-phone"))
}

@* ── Gap ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Gap", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:RowBuilder defaults to Gap.G3. Pass a different gap via SetGap(Gap.GN).
        }
    }
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/RowAndCol/_RowColGap", "Gap", IconStruct.Bootstrap("bi-distribute-horizontal"))
}
