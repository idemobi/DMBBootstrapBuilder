@{
    Layout = "_Layout";
}

@using (Html.SectionBuilder().SetHeight(125, UnitSize.px).BootstrapBackgroundEffect(VariantStyle.Normal).Begin())
{
    @using (Html.FlexBlockBuilder().SetAlignItemsCenter().SetJustifyContentCenter().Begin())
    {
        @using (Html.BlockBuilder().AsTextCenter().Begin())
        {
            @Html.TitleBuilder().SetTitle("RTL Toggle", TitleLevel.One).Render()
            @using (Html.PB_P().AsMuted().Begin())
            {
                @:Switch text direction between left-to-right and right-to-left.
            }
        }
    }
}

@* ── RTLToggleActionItem ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("RTLToggleActionItem", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:Applies or removes the RTL direction attribute on the page content area. Pass true for RTL, false for LTR.
        }
    }
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/RTL/_RTLToggle", "RTL toggle", IconStruct.Bootstrap("bi-text-right"))
}
