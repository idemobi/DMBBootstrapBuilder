@{
    Layout = "_Layout";
    string DocUrl(string c) => $"/Documentation/Show?packageId=DMBBootstrapBuilder&groupName=NuGet&namespaceName=DMBBootstrapBuilder&objectName={c}";
}

@using (Html.SectionBuilder().SetHeight(125, UnitSize.px).BootstrapBackgroundEffect(VariantStyle.Normal).Begin())
{
    @using (Html.FlexBlockBuilder().SetAlignItemsCenter().SetJustifyContentCenter().Begin())
    {
        @using (Html.BlockBuilder().AsTextCenter().Begin())
        {
            @Html.TitleBuilder().SetTitle("Alert", TitleLevel.One).Render()
            @using (Html.PB_P().AsMuted().Begin())
            {
                @:Inline feedback messages — coloured, dismissible, with icons, titles and footer actions.
            }
        }
    }
}

@* ── Variants ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Variants", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetVariant(VariantStyle) applies a Bootstrap colour to the alert. SetMessage(string) sets the body text.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(AlertBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @using (Html.BlockBuilder().AsExamplePreview().Begin())
    {
        @await Html.PartialAsync("~/Views/Shared/Examples/Alert/_AlertVariants.cshtml")
    }
    @await Html.RenderExamplePartialAsync("Examples/Alert/_AlertVariantsFocused", "Variants", IconStruct.Bootstrap("bi-palette"))
}

@* ── Title & Icon ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Title & Icon", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetTitle(string) adds a heading above the message. SetIcon(IconStruct) adds a leading icon next to it.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(AlertBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Alert/_AlertTitleAndIcon", "Title & icon", IconStruct.Bootstrap("bi-card-heading"))
}

@* ── Dismissible ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Dismissible", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetDismissible() adds a close button. Pass animated: true for a Bootstrap fade-out transition.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(AlertBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Alert/_AlertDismissible", "Dismissible", IconStruct.Bootstrap("bi-x-circle"))
}

@* ── Footer actions ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Footer actions", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:AddFooterAction(IActionItem) appends a button row below the message. Multiple actions can be chained.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(AlertBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Alert/_AlertFooterActions", "Footer actions", IconStruct.Bootstrap("bi-ui-checks"))
}
