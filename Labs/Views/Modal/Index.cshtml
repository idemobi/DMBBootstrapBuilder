@{
    Layout = "_Layout";
    string DocUrl(string c) => $"/Documentation/Show?packageId=DMBBootstrapBuilder&groupName=NuGet&namespaceName=DMBBootstrapBuilder&objectName={c}";
}

@using (Html.SectionBuilder().SetHeight(125, UnitSize.px).BootstrapBackgroundEffect(VariantStyle.Normal).Begin())
{
    @using (Html.FlexBlockBuilder().SetAlignItemsCenter().SetJustifyContentCenter().Begin())
    {
        @using (Html.BlockBuilder().AsTextCenter().Begin())
        {
            @Html.TitleBuilder().SetTitle("Modal", TitleLevel.One).Render()
            @using (Html.PB_P().AsMuted().Begin())
            {
                @:Overlay dialogs with configurable header, body, footer, size and colour variant.
            }
        }
    }
}

@* ── Basic modal ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Basic modal", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:ModalBuilder is declared once on the page. ActionItemFactory.Modal(title, id) renders the trigger button that opens it.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ModalBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Modal/_ModalBasic", "Basic modal", IconStruct.Bootstrap("bi-window"))
}

@* ── Sizes ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Sizes", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:Size(ModalSize) controls the dialog width — Sm, Lg and Xl are available in addition to the default.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ModalBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Modal/_ModalSizes", "Sizes", IconStruct.Bootstrap("bi-arrows-angle-expand"))
}

@* ── Variant ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Variant", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:WithVariant(VariantStyle) applies a Bootstrap colour to the modal header — the same set available on cards and alerts.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ModalBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Modal/_ModalVariant", "Variant", IconStruct.Bootstrap("bi-palette"))
}

@* -- Previews -- *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Previews", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:AddPDFPreviewURL(string) renders a deferred PDF preview. AddImagePreviewURL(string) renders a responsive PNG or JPEG preview inside the modal body.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ModalBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Modal/_ModalPdfPreviewFragment", "PDF preview", IconStruct.Bootstrap("bi-file-earmark-pdf"))
    @await Html.RenderExamplePartialAsync("Examples/Modal/_ModalImagePreviewFragment", "Image preview", IconStruct.Bootstrap("bi-image"))
}
