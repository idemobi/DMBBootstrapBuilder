@{
    Layout = "_Layout";
    string DocUrl(string c) => $"/Documentation/Show?packageId=DMBBootstrapBuilder&groupName=NuGet&namespaceName=DMBBootstrapBuilder&objectName={c}";
}

@using (Html.SectionBuilder().SetHeight(125, UnitSize.px).BootstrapBackgroundEffect(VariantStyle.Normal).Begin())
{
    @using (Html.FlexBlockBuilder().SetAlignItemsCenter().SetJustifyContentCenter().Begin())
    {
        @using (Html.BlockBuilder().AsTextCenter().Begin())
        {
            @Html.TitleBuilder().SetTitle("Title", TitleLevel.One).Render()
            @using (Html.PB_P().AsMuted().Begin())
            {
                @:Semantic heading tags — levels, Bootstrap text variants, transforms, shadows and icons.
            }
        }
    }
}

@* ── Heading levels — galerie 2 colonnes + code ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Heading levels", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetTitle(string, TitleLevel) controls the heading element — One renders an h1, Six renders an h6.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(TitleBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @using (Html.BlockBuilder().AsExamplePreview().Begin())
    {
        @await Html.PartialAsync("~/Views/Shared/Examples/Title/_TitleLevelsGallery.cshtml")
    }
    @await Html.RenderExamplePartialAsync("Examples/Title/_TitleLevels", "All levels", IconStruct.Bootstrap("bi-list-ol"))
}

@* ── Icon — code seul ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Icon", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetIconBootstrap(string) prepends a Bootstrap icon before the heading text.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(TitleBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Title/_TitleWithIcon", "With icon", IconStruct.Bootstrap("bi-image"))
}

