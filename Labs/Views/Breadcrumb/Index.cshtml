@{
    Layout = "_Layout";
    string DocUrl(string c) => $"/Documentation/Show?packageId=DMBBootstrapBuilder&groupName=NuGet&namespaceName=DMBBootstrapBuilder&objectName={c}";
}

@using (Html.SectionBuilder().SetHeight(125, UnitSize.px).BootstrapBackgroundEffect(VariantStyle.Normal).Begin())
{
    @using (Html.FlexBlockBuilder().SetAlignItemsCenter().SetJustifyContentCenter().Begin())
    {
        @using (Html.BlockBuilder().AsTextCenter().Begin())
        {
            @Html.TitleBuilder().SetTitle("Breadcrumb", TitleLevel.One).Render()
            @using (Html.PB_P().AsMuted().Begin())
            {
                @:Navigation trail showing the current page's location within the application hierarchy.
            }
        }
    }
}

@* ── Display modes ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Display modes", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetDisplayMode(BreadcrumbDisplayMode) controls whether each item shows its icon, its title, or both.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(BreadcrumbBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Breadcrumb/_BreadcrumbDisplayModes", "Display modes", IconStruct.Bootstrap("bi-eye"))
}

@* ── Custom separator ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Custom separator", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetSeparator(string) replaces the default slash with any character or string.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(BreadcrumbBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Breadcrumb/_BreadcrumbSeparator", "Custom separator", IconStruct.Bootstrap("bi-chevron-right"))
}

@* ── Collapse ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Collapse", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetCollapseAfter(int) hides intermediate items when the path exceeds the given depth — a "…" expander reveals the rest.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(BreadcrumbBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Breadcrumb/_BreadcrumbCollapse", "Collapse", IconStruct.Bootstrap("bi-arrows-collapse"))
}
