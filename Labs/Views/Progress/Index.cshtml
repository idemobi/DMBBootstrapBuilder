@{
    Layout = "_Layout";
    string DocUrl(string c) => $"/Documentation/Show?packageId=DMBBootstrapBuilder&groupName=NuGet&namespaceName=DMBBootstrapBuilder&objectName={c}";
}

@using (Html.SectionBuilder().SetHeight(125, UnitSize.px).BootstrapBackgroundEffect(VariantStyle.Normal).Begin())
{
    @using (Html.FlexBlockBuilder().SetAlignItemsCenter().SetJustifyContentCenter().Begin())
    {
        @using (Html.BlockBuilder().AsTextCenter().Begin())
        {
            @Html.TitleBuilder().SetTitle("Progress", TitleLevel.One).Render()
            @using (Html.PB_P().AsMuted().Begin())
            {
                @:Horizontal progress bars — single or stacked, with variants, sizes, labels and animations.
            }
        }
    }
}

@* ── Basic ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Basic", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:Html.ProgressBar().SetValue(int) renders a progress bar. SetVariant(VariantStyle) applies a Bootstrap colour.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ProgressBarBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @using (Html.BlockBuilder().AsExamplePreview().Begin())
    {
        @await Html.PartialAsync("~/Views/Shared/Examples/Progress/_ProgressBasic.cshtml")
    }
    @await Html.RenderExamplePartialAsync("Examples/Progress/_ProgressBasicFocused", "Basic bars", IconStruct.Bootstrap("bi-bar-chart-fill"))
}

@* ── Label ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Label", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetShowLabel() displays the percentage inside the bar. SetLabel(string) replaces the auto-generated text with a custom value.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ProgressBarBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Progress/_ProgressLabel", "Label", IconStruct.Bootstrap("bi-fonts"))
}

@* ── Striped & Animated ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Striped & Animated", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetStriped() adds a diagonal stripe pattern. SetAnimated() makes the stripes slide — useful to indicate an ongoing process.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ProgressBarBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Progress/_ProgressStriped", "Striped & animated", IconStruct.Bootstrap("bi-slash-lg"))
}

@* ── Sizes ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Sizes", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:SetSize(ProgressBarSize) picks a predefined height. SetHeight(int, UnitSize) sets an exact pixel or rem value.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ProgressBarBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
