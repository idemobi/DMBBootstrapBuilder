@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @using (Html.BlockBuilder().AsExamplePreview().Begin())
    {
        @await Html.PartialAsync("~/Views/Shared/Examples/Progress/_ProgressSizes.cshtml")
    }
    @await Html.RenderExamplePartialAsync("Examples/Progress/_ProgressSizesFocused", "Sizes", IconStruct.Bootstrap("bi-arrows-expand"))
}

@* ── Stacked ── *@
@using (Html.BlockBuilder().AsSectionHeader().Begin())
{
    @using (Html.BlockBuilder().Begin())
    {
        @Html.TitleBuilder().SetTitle("Stacked", TitleLevel.Three).Render()
        @using (Html.PB_P().AsMuted().Begin())
        {
            @:Html.ProgressBarStack() combines multiple bars into a single track. Each segment keeps its own variant and label.
        }
    }
    @Html.Button(ActionItemFactory.Url(title: "", url: DocUrl(nameof(ProgressBarStackBuilder)), icon: IconStruct.Bootstrap("bi-book-half")).SetVariant(VariantStyle.Secondary).SetOutlined()).Render()
}

@using (Html.BlockBuilder().AsSectionContent().Begin())
{
    @await Html.RenderExamplePartialAsync("Examples/Progress/_ProgressStacked", "Stacked", IconStruct.Bootstrap("bi-stack"))
}
